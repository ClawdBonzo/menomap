    "Sweater on. Sweater off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألبس السترة. أخلع السترة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetr na sebe. Svetr dolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweateren på. Sweateren af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulli an. Pulli aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζακέτα φοράω. Ζακέτα βγάζω."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweater on. Sweater off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jersey puesto. Jersey fuera."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Suéter puesto. Suéter fuera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Villapaita päälle. Villapaita pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull enfilé. Pull enlevé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוודר עולה. סוודר יורד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वेटर पहना। स्वेटर उतारा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestu obuci. Vestu skini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulcsi fel. Pulcsi le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaket dipakai. Jaket dilepas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglione sì. Maglione no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着て、脱いで、また着て。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스웨터 입고. 스웨터 벗고."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai sweater. Buka sweater."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Genser på. Genser av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trui aan. Trui uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweter włożyć. Sweter zdjąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Casaquinho: tira, põe, tira de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Camisola: tira, põe, tira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puloverul pe mine. Puloverul jos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveter na seba. Sveter dole."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tröjan på. Tröjan av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่เสื้อคลุม ถอดเสื้อคลุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hırka giy. Hırka çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Светр вдягла. Светр зняла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc áo len vào. Cởi áo len ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外套穿上。外套脱下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外套穿了又脫，脫了又穿。"
          }
        }
      }
    },
