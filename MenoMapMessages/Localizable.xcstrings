    "Rough night. I'll be slow this morning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليلة صعبة. سأكون بطيئة هذا الصباح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Těžká noc. Dneska ráno budu pomalejší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hård nat. Jeg er lidt langsom her til morgen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Harte Nacht. Ich bin heute Morgen langsam."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύσκολη νύχτα. Θα είμαι αργή σήμερα το πρωί."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rough night. I'll be slow this morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mala noche. Esta mañana iré lenta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Noche pesada. Esta mañana voy a ir con calma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankka yö. Olen hidas tänä aamuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuit difficile. Je serai au ralenti ce matin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לילה קשה. אהיה איטית הבוקר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रात भारी रही। आज सुबह मैं थोड़ी धीमी रहूँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teška noć. Jutros ću biti spora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehéz éjszaka volt. Ma reggel lassabb leszek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semalam berat. Pagi ini aku bakal lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nottataccia. Stamattina vado a rilento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つらい夜でした。今朝はゆっくりめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘든 밤이었어요. 오늘 아침은 좀 느릴 거예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam yang sukar. Saya akan lambat sedikit pagi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tøff natt. Jeg er treg i dag tidlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zware nacht. Ik ben vanochtend wat traag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciężka noc. Rano będę powolna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noite difícil. Vou estar mais lenta hoje de manhã."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Noite difícil. Hoje de manhã estou a meio gás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noapte grea. Azi-dimineață merg cu încetinitorul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťažká noc. Dnes ráno budem pomalšia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuff natt. Jag är lite seg i förmiddag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคืนนอนไม่ค่อยได้ เช้านี้อาจช้าหน่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zor bir geceydi. Bu sabah biraz yavaş olacağım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Важка ніч. Зранку я буду повільна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đêm qua mệt quá. Sáng nay mình sẽ hơi chậm chạp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚很难熬。今天早上我会慢一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚很難熬，我今天早上會慢一點。"
          }
        }
      }
    },
    "Running hot. Not you, it's me.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا في موجة حرّ. المشكلة فيّ، لا فيك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsem přehřátá. Nejde o tebe, jde o mě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører varmt. Det er ikke dig, det er mig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich laufe heiß. Liegt nicht an dir, liegt an mir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βράζω. Δεν φταις εσύ, εγώ φταίω."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Running hot. Not you, it's me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy que ardo. No eres tú, soy yo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ando acalorada. No eres tú, soy yo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuumottaa. Vika ei ole sinussa vaan minussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En surchauffe. Ce n’est pas toi, c’est moi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רותחת. זה לא אתם, זה אני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्मी चढ़ी है। बात तुम्हारी नहीं, मेरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregrijana sam. Nije do tebe, do mene je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túlmelegedtem. Nem veled van a baj, hanem velem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagi gerah. Bukan kamu, tapi aku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado a fuoco. Non sei tu, sono io."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただいま高温中。原因はあなたではなく、私です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 열 오르는 중. 누구 탓 아니고 제 몸 탓이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Badan tengah panas. Bukan sebab awak, sebab saya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg koker. Det er ikke deg, det er meg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik gloei. Het ligt niet aan jou, het ligt aan mij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegrzewam się. To nie ty, to ja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fervendo aqui. Não é você, sou eu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ando a ferver. Não és tu, sou eu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt pe foc. Nu ești tu, sunt eu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehrievam sa. Nie je to tebou, je to mnou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag går varm. Det är inte du, det är jag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวร้อนอยู่ ไม่ใช่เพราะคุณ เป็นที่ฉันเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ateş gibiyim. Sorun sende değil, bende."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегріваюся. Справа не в тобі, а в мені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang nóng trong người. Không phải tại ai, tại mình thôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点过热。不是你的问题，是我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體內小火爐全開。不是你的問題，是我的問題。"
          }
        }
      }
    },
