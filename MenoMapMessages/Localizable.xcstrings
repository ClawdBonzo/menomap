    "Heads up: running hot today. Not you, it's me.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه: أنا في موجة حرّ اليوم. المشكلة فيّ، لا فيك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro info: dneska jsem přehřátá. Nejde o tebe, jde o mě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til orientering: Jeg kører varmt i dag. Det er ikke dig, det er mig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorwarnung: Ich laufe heute heiß. Liegt nicht an dir, liegt an mir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ξέρεις: σήμερα βράζω. Δεν φταις εσύ, εγώ φταίω."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads up: running hot today. Not you, it's me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: hoy estoy que ardo. No eres tú, soy yo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: hoy ando acalorada. No eres tú, soy yo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoksi: minulla on tänään kuuma päivä. Vika ei ole sinussa vaan minussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour info : je suis en surchauffe aujourd’hui. Ce n’est pas toi, c’est moi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לידיעתכם: אני רותחת היום. זה לא אתם, זה אני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से बता दूँ: आज अंदर से गर्मी चढ़ी है। बात तुम्हारी नहीं, मेरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mala najava: danas sam pregrijana. Nije do tebe, do mene je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előre szólok: ma forró napom van. Nem veled van a baj, hanem velem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info: hari ini aku gampang gerah. Bukan kamu, tapi aku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhio: oggi vado a fuoco. Non sei tu, sono io."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にお知らせ：今日の私は高温注意報。原因はあなたではなく、私です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 말해 둘게요. 오늘 열이 좀 올라요. 누구 탓 아니고 제 몸 탓이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makluman: hari ini saya asyik panas. Bukan sebab awak, sebab saya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare så du vet det: Jeg koker litt i dag. Det er ikke deg, det er meg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even een seintje: ik gloei vandaag. Het ligt niet aan jou, het ligt aan mij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: dziś się przegrzewam. To nie ty, to ja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: hoje estou fervendo. Não é você, sou eu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: hoje ando a ferver. Não és tu, sou eu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Să știi: azi sunt pe foc. Nu ești tu, sunt eu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre istotu: dnes sa prehrievam. Nie je to tebou, je to mnou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förvarning: jag går varm idag. Det är inte du, det är jag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งไว้ก่อน วันนี้ตัวร้อนเป็นพิเศษ ไม่ใช่เพราะคุณ เป็นที่ฉันเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haberin olsun: bugün ateş gibiyim. Sorun sende değil, bende."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попереджаю: сьогодні я перегріваюся. Справа не в тобі, а в мені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo trước: hôm nay mình đang nóng trong người. Không phải tại ai, tại mình thôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前说一声：我今天有点过热。不是你的问题，是我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先說一聲：我今天體內小火爐全開。不是你的問題，是我的問題。"
          }
        }
      }
    },
