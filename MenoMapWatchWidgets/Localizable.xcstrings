          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním klepnutím začneš měřit vlnu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk for at starte tidtagning af en bølge."
          }
        },
