    "There are non-hormonal medicines, CBT and practical changes. A clinician can help you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك أدوية غير هرمونية، والعلاج المعرفي السلوكي، وتغييرات عملية. يمكن للطبيب مساعدتكِ في الاختيار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existují nehormonální léky, KBT a praktické změny. Lékař ti může pomoci vybrat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes ikke-hormonel medicin, kognitiv adfærdsterapi og praktiske ændringer. En læge kan hjælpe dig med at vælge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt nicht hormonelle Medikamente, KVT und praktische Veränderungen. Eine Ärztin oder ein Arzt kann dir bei der Auswahl helfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχουν μη ορμονικά φάρμακα, γνωσιακή συμπεριφορική θεραπεία και πρακτικές αλλαγές. Ένας γιατρός μπορεί να σε βοηθήσει να επιλέξεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are non-hormonal medicines, CBT and practical changes. A clinician can help you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay medicamentos no hormonales, TCC y cambios prácticos. Un profesional sanitario puede ayudarte a elegir."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay medicamentos no hormonales, terapia cognitivo-conductual (TCC) y cambios prácticos. Un profesional de la salud puede ayudarte a elegir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On olemassa hormonittomia lääkkeitä, kognitiivista käyttäytymisterapiaa ja käytännön muutoksia. Lääkäri voi auttaa sinua valitsemaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il existe des médicaments non hormonaux, la TCC et des changements pratiques. Un médecin peut vous aider à choisir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש תרופות לא הורמונליות, CBT ושינויים מעשיים. רופא/ה יכול/ה לעזור לך לבחור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना हार्मोन वाली दवाएँ, CBT और व्यावहारिक बदलाव जैसे विकल्प हैं। डॉक्टर आपको चुनने में मदद कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postoje nehormonski lijekovi, KBT i praktične promjene. Liječnik ti može pomoći odabrati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léteznek nem hormonális gyógyszerek, kognitív viselkedésterápia (KVT) és gyakorlati változtatások. Egy orvos segíthet választani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada obat nonhormonal, CBT, dan perubahan praktis. Dokter bisa membantumu memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esistono farmaci non ormonali, la terapia cognitivo-comportamentale (CBT) e cambiamenti pratici. Un medico può aiutarti a scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホルモンを使わない薬、認知行動療法（CBT）、日常の工夫があります。医師が選ぶ手助けをしてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비호르몬 약, 인지행동치료(CBT), 생활 속 변화가 있어요. 의료진이 선택을 도와줄 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terdapat ubat bukan hormon, CBT dan perubahan praktikal. Doktor boleh membantu anda memilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ikke-hormonelle medisiner, kognitiv atferdsterapi og praktiske endringer. En lege kan hjelpe deg å velge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn niet-hormonale medicijnen, CGT en praktische aanpassingen. Een arts kan je helpen kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istnieją leki niehormonalne, CBT i praktyczne zmiany. Lekarz może pomóc ci wybrać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existem medicamentos não hormonais, TCC e mudanças práticas. Um profissional de saúde pode ajudar você a escolher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há medicamentos não hormonais, TCC e mudanças práticas. Um profissional de saúde pode ajudar-te a escolher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Există medicamente nehormonale, TCC și schimbări practice. Un medic te poate ajuta să alegi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existujú nehormonálne lieky, kognitívno-behaviorálna terapia (KBT) a praktické zmeny. Lekár ti pomôže vybrať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns icke-hormonella läkemedel, KBT och praktiska förändringar. En läkare kan hjälpa dig att välja."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มียาที่ไม่ใช่ฮอร์โมน CBT และการปรับเปลี่ยนในชีวิตประจำวัน แพทย์ช่วยคุณเลือกได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormon içermeyen ilaçlar, BDT ve pratik değişiklikler var. Seçmene bir doktor yardımcı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Є негормональні ліки, КПТ і практичні зміни. Лікар може допомогти тобі вибрати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có các thuốc không chứa hormone, liệu pháp nhận thức hành vi (CBT) và những thay đổi thực tế. Bác sĩ có thể giúp bạn lựa chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有非激素类药物、认知行为疗法（CBT）和一些实用的改变。医生可以帮你选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有非荷爾蒙藥物、認知行為治療（CBT）和實用的生活調整。醫師可以幫你選擇。"
          }
        }
      }
    },
    "There's no sign-in. MenoMap never uploads your health data, and nothing is stored in iCloud by the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد تسجيل دخول. لا يرفع MenoMap بياناتكِ الصحية أبدًا، ولا يخزّن التطبيق أي شيء في iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné přihlašování. MenoMap nikdy nenahrává tvoje zdravotní data a aplikace nic neukládá na iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet login. MenoMap uploader aldrig dine helbredsdata, og appen gemmer intet i iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Anmeldung. MenoMap lädt deine Gesundheitsdaten nie hoch, und die App speichert nichts in iCloud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει σύνδεση λογαριασμού. Το MenoMap δεν ανεβάζει ποτέ τα δεδομένα υγείας σου και η εφαρμογή δεν αποθηκεύει τίποτα στο iCloud."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no sign-in. MenoMap never uploads your health data, and nothing is stored in iCloud by the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay inicio de sesión. MenoMap nunca sube tus datos de salud y la app no guarda nada en iCloud."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay inicio de sesión. MenoMap nunca sube tus datos de salud, y la app no guarda nada en iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumista ei ole. MenoMap ei koskaan lataa terveystietojasi minnekään, eikä appi tallenna mitään iCloudiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion à un compte. MenoMap n’envoie jamais vos données de santé en ligne, et l’app ne stocke rien dans iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין התחברות. MenoMap אף פעם לא מעלה את נתוני הבריאות שלך, והיישום לא שומר שום דבר ב-iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई साइन-इन नहीं। MenoMap आपका सेहत डेटा कभी अपलोड नहीं करता, और ऐप iCloud में कुछ भी स्टोर नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema prijave. MenoMap nikad ne prenosi tvoje zdravstvene podatke i aplikacija ništa ne sprema na iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs bejelentkezés. A MenoMap soha nem tölti fel az egészségügyi adataidat, és az app semmit sem tárol az iCloudban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
