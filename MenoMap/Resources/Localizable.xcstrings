            "state" : "translated",
            "value" : "Vi følger ikke med i, hvad du registrerer. Køb tælles anonymt for at måle App Store og Apple Ads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verfolgen nicht, was du einträgst. Käufe werden anonym gezählt, um den App Store und Apple Ads auszuwerten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν παρακολουθούμε όσα καταγράφεις. Οι αγορές καταμετρώνται ανώνυμα για τη μέτρηση της απόδοσης στο App Store και στο Apple Ads."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't track what you log. Purchases are counted anonymously to measure the App Store and Apple Ads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hacemos seguimiento de lo que registras. Las compras se cuentan de forma anónima para medir los resultados en el App Store y Apple Ads."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hacemos seguimiento de lo que registras. Las compras se cuentan de forma anónima para medir el App Store y Apple Ads."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme seuraa, mitä kirjaat. Ostot lasketaan nimettömästi App Storen ja Apple Adsin tehon mittaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne suivons pas ce que vous notez. Les achats sont comptabilisés de façon anonyme pour mesurer les résultats de l’App Store et d’Apple Ads."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנחנו לא עוקבים אחרי מה שאת מתעדת. רכישות נספרות באופן אנונימי כדי למדוד את ה-App Store ואת Apple Ads."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो दर्ज करती हैं, हम उसे ट्रैक नहीं करते। App Store और Apple Ads को मापने के लिए ख़रीदारियाँ गुमनाम रूप से गिनी जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pratimo što bilježiš. Kupnje se broje anonimno radi mjerenja učinka App Storea i oglasa Apple Ads."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem követjük, mit rögzítesz. A vásárlásokat névtelenül számoljuk, hogy mérjük az App Store és az Apple Ads hatékonyságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak melacak apa yang kamu catat. Pembelian dihitung secara anonim untuk mengukur App Store dan Apple Ads."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tracciamo ciò che registri. Gli acquisti vengono contati in forma anonima per misurare l'App Store e Apple Ads."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した内容を追跡することはありません。App StoreとApple Adsの効果測定のため、購入は匿名で集計されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록한 내용은 추적하지 않아요. 구입은 App Store와 Apple Ads 성과 측정을 위해 익명으로 집계돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menjejaki apa yang anda catat. Pembelian dikira secara tanpa nama untuk mengukur prestasi App Store dan Apple Ads."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sporer ikke det du registrerer. Kjøp telles anonymt for å måle App Store og Apple Ads."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We houden niet bij wat je noteert. Aankopen worden anoniem geteld om de resultaten van de App Store en Apple Ads te meten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie śledzimy tego, co zapisujesz. Zakupy są liczone anonimowo, aby mierzyć skuteczność App Store i Apple Ads."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não rastreamos o que você registra. As compras são contadas de forma anônima para medir o desempenho na App Store e no Apple Ads."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não acompanhamos o que registas. As compras são contabilizadas de forma anónima para medir o desempenho na App Store e no Apple Ads."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu urmărim ce înregistrezi. Achizițiile sunt numărate anonim, ca să măsurăm rezultatele din App Store și Apple Ads."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesledujeme, čo zaznamenávaš. Nákupy sa počítajú anonymne na vyhodnotenie App Storu a Apple Ads."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi följer inte vad du loggar. Köp räknas anonymt för att mäta App Store och Apple Ads."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราไม่ติดตามสิ่งที่คุณบันทึก การซื้อจะนับแบบไม่ระบุตัวตนเพื่อวัดผล App Store และ Apple Ads"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydettiklerini takip etmiyoruz. Satın alımlar, App Store ve Apple Ads ölçümü için anonim olarak sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми не відстежуємо те, що ти записуєш. Покупки враховуються анонімно, щоб оцінювати ефективність App Store і Apple Ads."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi không theo dõi những gì bạn ghi. Giao dịch mua được đếm ẩn danh để đo lường App Store và Apple Ads."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不追踪你记录的内容。购买行为会被匿名统计，用于衡量 App Store 和 Apple Ads 的效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們不追蹤你記錄的內容。購買會以匿名方式計算，用於評估 App Store 和 Apple Ads 的成效。"
          }
        }
      }
    },
