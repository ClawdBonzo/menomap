            "value" : "Картки й PDF-файли створюються на твоєму iPhone і залишають його, лише якщо ти їх надішлеш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ chia sẻ và PDF được tạo trên iPhone của bạn và chỉ rời khỏi máy khi bạn gửi đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享卡片和 PDF 都在你的 iPhone 上生成，只有你发送时才会离开手机。"
