    "Deletes everything MenoMap stores on this iPhone. Data in Apple Health stays until you remove it in the Health app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل ما يخزّنه MenoMap على هذا الـiPhone. تبقى البيانات في تطبيق صحتي إلى أن تحذفيها منه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže vše, co MenoMap ukládá na tomto iPhonu. Data v aplikaci Zdraví zůstanou, dokud je neodstraníš v aplikaci Zdraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter alt, hvad MenoMap gemmer på denne iPhone. Data i Apple Sundhed bliver, indtil du fjerner dem i appen Sundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alles, was MenoMap auf diesem iPhone speichert. Daten in Apple Health bleiben erhalten, bis du sie in der Health-App entfernst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει όλα όσα αποθηκεύει το MenoMap σε αυτό το iPhone. Τα δεδομένα στην εφαρμογή Υγεία παραμένουν μέχρι να τα αφαιρέσεις από την εφαρμογή Υγεία."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes everything MenoMap stores on this iPhone. Data in Apple Health stays until you remove it in the Health app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo lo que MenoMap guarda en este iPhone. Los datos de la app Salud se conservan hasta que los borres en la propia app Salud."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo lo que MenoMap guarda en este iPhone. Los datos en la app Salud se conservan hasta que los elimines desde la app Salud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa kaiken, mitä MenoMap tallentaa tähän iPhoneen. Terveys-apin tiedot säilyvät, kunnes poistat ne Terveys-apissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tout ce que MenoMap stocke sur cet iPhone. Les données enregistrées dans Santé y restent jusqu’à ce que vous les retiriez dans l’app Santé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק את כל מה ש-MenoMap שומר ב-iPhone הזה. נתונים ב״בריאות״ נשארים שם עד שתסירי אותם ביישום ״בריאות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap इस iPhone पर जो कुछ रखता है, वह सब मिट जाएगा। सेहत ऐप का डेटा तब तक रहेगा जब तक आप उसे सेहत ऐप में न हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briše sve što MenoMap sprema na ovom iPhoneu. Podaci u aplikaciji Zdravlje ostaju dok ih ne ukloniš u aplikaciji Zdravlje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töröl mindent, amit a MenoMap ezen az iPhone-on tárol. Az Egészség appban lévő adatok megmaradnak, amíg ott el nem távolítod őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua yang disimpan MenoMap di iPhone ini. Data di app Kesehatan tetap ada sampai kamu menghapusnya di app Kesehatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutto ciò che MenoMap conserva su questo iPhone. I dati nell'app Salute restano finché non li rimuovi dall'app Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMapがこのiPhoneに保存しているデータをすべて削除します。ヘルスケアのデータは、ヘルスケア Appで削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap이 이 iPhone에 저장한 모든 것을 삭제해요. 건강 앱의 데이터는 건강 앱에서 직접 지울 때까지 남아 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memadam semua yang disimpan oleh MenoMap pada iPhone ini. Data dalam app Kesihatan kekal sehingga anda membuangnya dalam app Kesihatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter alt MenoMap lagrer på denne iPhonen. Data i Apple Helse blir liggende til du fjerner dem i Helse-appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alles wat MenoMap op deze iPhone bewaart. Gegevens in de Gezondheid-app blijven staan tot je ze daar zelf verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wszystko, co MenoMap przechowuje na tym iPhonie. Dane w aplikacji Zdrowie pozostaną, dopóki ich tam nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga tudo o que o MenoMap guarda neste iPhone. Os dados no app Saúde continuam lá até você removê-los no app Saúde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga tudo o que o MenoMap guarda neste iPhone. Os dados na aplicação Saúde ficam lá até os removeres na própria aplicação Saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge tot ce stochează MenoMap pe acest iPhone. Datele din aplicația Sănătate rămân acolo până le elimini din aplicația Sănătate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymaže všetko, čo MenoMap ukladá v tomto iPhone. Údaje v apke Zdravie zostanú, kým ich v apke Zdravie neodstrániš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar allt som MenoMap sparar på den här iPhonen. Data i appen Hälsa finns kvar tills du tar bort den i Hälsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบทุกอย่างที่ MenoMap เก็บไว้ใน iPhone เครื่องนี้ ข้อมูลในแอปสุขภาพจะยังอยู่จนกว่าคุณจะลบในแอปสุขภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap'ın bu iPhone'da sakladığı her şeyi siler. Sağlık uygulamasındaki veriler, sen oradan kaldırana kadar Sağlık uygulamasında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє все, що MenoMap зберігає на цьому iPhone. Дані в програмі «Здоровʼя» залишаться, доки ти не видалиш їх там."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi thứ MenoMap lưu trên iPhone này. Dữ liệu trong ứng dụng Sức khỏe vẫn được giữ cho đến khi bạn xóa trong ứng dụng Sức khỏe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 MenoMap 在此 iPhone 上存储的所有内容。健康 App 中的数据会保留，直到你在健康 App 中将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 MenoMap 儲存在這部 iPhone 上的所有內容。「健康」App 中的資料會保留，直到你在「健康」App 中移除。"
          }
        }
      }
    },
