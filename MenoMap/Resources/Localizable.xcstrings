    "Share cards and PDFs are made on your iPhone and leave it only if you send them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشأ بطاقات المشاركة وملفات PDF على الـiPhone الخاص بكِ، ولا تغادره إلا إذا أرسلتِها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty ke sdílení a PDF se vytvářejí na tvém iPhonu a opustí ho, jen když je odešleš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delingskort og pdf'er laves på din iPhone og forlader den kun, hvis du sender dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten und PDFs zum Teilen werden auf deinem iPhone erstellt und verlassen es nur, wenn du sie sendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κάρτες κοινής χρήσης και τα PDF δημιουργούνται στο iPhone σου και φεύγουν από αυτό μόνο αν τα στείλεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share cards and PDFs are made on your iPhone and leave it only if you send them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas y los PDF se crean en tu iPhone y solo salen de él si tú los envías."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas para compartir y los PDF se crean en tu iPhone y solo salen de él si tú los envías."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakokortit ja PDF:t tehdään iPhonessasi, ja ne lähtevät sieltä vain, jos lähetät ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes à partager et les PDF sont créés sur votre iPhone et ne le quittent que si vous les envoyez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כרטיסי שיתוף וקובצי PDF נוצרים ב-iPhone שלך ויוצאים ממנו רק אם את שולחת אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेयर कार्ड और PDF आपके iPhone पर बनते हैं और तभी बाहर जाते हैं जब आप उन्हें भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartice za dijeljenje i PDF-ovi izrađuju se na tvom iPhoneu i napuštaju ga samo ako ih pošalješ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megosztókártyák és a PDF-ek az iPhone-odon készülnek, és csak akkor hagyják el, ha elküldöd őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu berbagi dan PDF dibuat di iPhone-mu dan hanya keluar dari sana jika kamu mengirimnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede e i PDF da condividere vengono creati sul tuo iPhone e lo lasciano solo se li invii tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有カードとPDFはiPhone上で作成され、あなたが送信しない限りiPhoneの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 카드와 PDF는 iPhone에서 만들어지고, 직접 보낼 때만 밖으로 나가요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad kongsi dan PDF dibuat pada iPhone anda dan hanya keluar daripadanya jika anda menghantarnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delingskort og PDF-er lages på iPhonen din og forlater den bare hvis du sender dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deelkaarten en pdf's worden op je iPhone gemaakt en verlaten die alleen als je ze verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty i pliki PDF powstają na twoim iPhonie i opuszczają go tylko wtedy, gdy je wyślesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões e PDFs são criados no seu iPhone e só saem dele se você enviar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões e os PDF são criados no teu iPhone e só saem dele se os enviares."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cardurile de distribuit și PDF-urile sunt create pe iPhone-ul tău și îl părăsesc doar dacă le trimiți."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartičky na zdieľanie a PDF sa vytvárajú v tvojom iPhone a opustia ho, len ak ich odošleš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delningskort och PDF:er skapas på din iPhone och lämnar den bara om du skickar dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดแชร์และ PDF สร้างขึ้นบน iPhone ของคุณ และจะออกจากเครื่องก็ต่อเมื่อคุณส่งเท่านั้น"
