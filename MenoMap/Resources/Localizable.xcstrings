    "Day %lld of %lld. Keep logging as usual; MenoMap compares with the %lld days before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم %1$lld من %2$lld. تابعي التسجيل كالمعتاد؛ سيقارن MenoMap بالأيام الـ%3$lld السابقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den %1$lld z %2$lld. Zaznamenávej jako obvykle; MenoMap porovná výsledky s %3$lld dny předtím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag %1$lld af %2$lld. Fortsæt med at registrere som normalt; MenoMap sammenligner med de %3$lld dage før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag %1$lld von %2$lld. Trag weiter wie gewohnt ein, MenoMap vergleicht mit den %3$lld Tagen davor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ημέρα %1$lld από %2$lld. Συνέχισε την καταγραφή όπως συνήθως. Το MenoMap συγκρίνει με τις %3$lld προηγούμενες ημέρες."
          }
        },
        "en" : {
          "stringUnit" : {
