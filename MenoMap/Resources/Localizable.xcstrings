    "Turn it on in You → Night Watch and set your bedtime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّليها من ملفّي ← حراسة الليل وحدّدي وقت نومكِ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapni ji v Já → Noční hlídka a nastav si večerku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå den til under Dig → Nattevagt, og indstil din sengetid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte sie unter Ich → Nachtwache ein und leg deine Schlafenszeit fest."
