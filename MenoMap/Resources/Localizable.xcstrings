    "Options for people who can't or don't want to use hormones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيارات لمن لا يستطيع استخدام الهرمونات أو لا يرغب في ذلك."
          }
        },
