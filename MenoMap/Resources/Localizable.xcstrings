    "Add the date and MenoMap will get your notes ready in time. Optional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفي التاريخ وسيجهّز MenoMap ملاحظاتكِ في الوقت المناسب. اختياري."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej datum a MenoMap ti poznámky připraví včas. Nepovinné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj datoen, så gør MenoMap dine noter klar i tide. Valgfrit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag das Datum ein, und MenoMap bereitet deine Notizen rechtzeitig vor. Optional."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε την ημερομηνία και το MenoMap θα ετοιμάσει εγκαίρως τις σημειώσεις σου. Προαιρετικό."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the date and MenoMap will get your notes ready in time. Optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la fecha y MenoMap tendrá tus notas listas a tiempo. Opcional."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega la fecha y MenoMap tendrá tus notas listas a tiempo. Opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää päivämäärä, niin MenoMap valmistelee muistiinpanosi ajoissa. Vapaaehtoinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez la date et MenoMap préparera vos notes à temps. Facultatif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפי את התאריך, ו-MenoMap יכין את הסיכום שלך בזמן. לא חובה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तारीख़ जोड़ें, MenoMap आपके नोट्स समय पर तैयार कर देगा। वैकल्पिक।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj datum i MenoMap će na vrijeme pripremiti tvoje bilješke. Nije obavezno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg a dátumot, és a MenoMap időben elkészíti a jegyzeteidet. Nem kötelező."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tanggalnya, dan MenoMap akan menyiapkan catatanmu tepat waktu. Opsional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la data e MenoMap preparerà le tue note in tempo. Facoltativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付を追加すると、受診に間に合うようにMenoMapがメモを準備します。任意です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 추가하면 MenoMap이 제때 진료 메모를 준비해 줘요. 선택 사항이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tarikhnya dan MenoMap akan menyediakan nota anda tepat pada masanya. Tidak wajib."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn datoen, så gjør MenoMap notatene dine klare i tide. Valgfritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de datum in, dan zorgt MenoMap dat je notities op tijd klaar zijn. Optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
