    "To change what MenoMap can read or write: Settings → Health → Data Access & Devices → MenoMap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتغيير ما يمكن لـMenoMap قراءته أو كتابته: الإعدادات ← صحتي ← الوصول إلى البيانات والأجهزة ← MenoMap."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš-li změnit, co MenoMap může číst nebo zapisovat: Nastavení → Zdraví → Přístup k datům a zařízení → MenoMap."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådan ændrer du, hvad MenoMap kan læse eller skrive: Indstillinger → Sundhed → Dataadgang og enheder → MenoMap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um zu ändern, was MenoMap lesen oder schreiben darf: Einstellungen → Health → Datenzugriff & Geräte → MenoMap."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να αλλάξεις τι μπορεί να διαβάζει ή να γράφει το MenoMap: Ρυθμίσεις → Υγεία → Πρόσβαση σε δεδομένα και συσκευές → MenoMap."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To change what MenoMap can read or write: Settings → Health → Data Access & Devices → MenoMap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar lo que MenoMap puede leer o escribir: Ajustes → Salud → Acceso a datos y dispositivos → MenoMap."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar lo que MenoMap puede leer o escribir: Configuración → Salud → Acceso a datos y dispositivos → MenoMap."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta MenoMapin luku- ja kirjoitusoikeuksia Terveys-apissa: Yhteenveto → kuvasi tai nimikirjaimesi → Tietosuoja → Apit → MenoMap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour changer ce que MenoMap peut lire ou écrire : Réglages → Santé → Accès aux données et appareils → MenoMap."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לשנות מה MenoMap יכול לקרוא או לכתוב: ״הגדרות״ ← ״בריאות״ ← ״גישה לנתונים ומכשירים״ ← MenoMap."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap क्या पढ़ या लिख सकता है, यह बदलने के लिए: सेटिंग्ज़ → सेहत → डेटा ऐक्सेस और डिवाइस → MenoMap।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za promjenu onoga što MenoMap smije čitati ili zapisivati: Postavke → Zdravlje → Pristup podacima i uređaji → MenoMap."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha módosítani szeretnéd, mit olvashat vagy írhat a MenoMap: Beállítások → Egészség → Adathozzáférés és eszközök → MenoMap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengubah apa yang bisa dibaca atau ditulis MenoMap: Pengaturan → Kesehatan → Akses Data & Perangkat → MenoMap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per cambiare ciò che MenoMap può leggere o scrivere: Impostazioni → Salute → Accesso ai dati e dispositivi → MenoMap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMapが読み書きできるデータを変更するには：「設定」→「ヘルスケア」→「データアクセスとデバイス」→「MenoMap」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap이 읽거나 기록할 수 있는 항목을 바꾸려면: 설정 → 건강 → 데이터 접근 및 기기 → MenoMap."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menukar apa yang MenoMap boleh baca atau tulis: Seting → Kesihatan → Akses Data & Peranti → MenoMap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slik endrer du hva MenoMap kan lese eller skrive: Innstillinger → Helse → Datatilgang og enheter → MenoMap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te wijzigen wat MenoMap kan lezen of schrijven: Instellingen → Gezondheid → Gegevenstoegang en apparaten → MenoMap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zmienić, co MenoMap może odczytywać lub zapisywać: Ustawienia → Zdrowie → Dostęp do danych i urządzenia → MenoMap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mudar o que o MenoMap pode ler ou gravar: Ajustes → Saúde → Acesso a Dados e Dispositivos → MenoMap."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para alterar o que o MenoMap pode ler ou escrever: Definições → Saúde → Acesso a dados e dispositivos → MenoMap."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca să schimbi ce poate citi sau scrie MenoMap: Configurări → Sănătate → Acces la date și dispozitive → MenoMap."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chceš zmeniť, čo MenoMap môže čítať alebo zapisovať: Nastavenia → Zdravie → Prístup k dátam a zariadenia → MenoMap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så ändrar du vad MenoMap får läsa eller skriva: Inställningar → Hälsa → Dataåtkomst och enheter → MenoMap."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการเปลี่ยนสิ่งที่ MenoMap อ่านหรือเขียนได้: การตั้งค่า → สุขภาพ → การเข้าถึงข้อมูลและอุปกรณ์ → MenoMap"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MenoMap'ın neleri okuyup yazabileceğini değiştirmek için: Ayarlar → Sağlık → Veri Erişimi ve Aygıtlar → MenoMap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб змінити, що MenoMap може читати або записувати: Параметри → Здоровʼя → Доступ до даних і пристрої → MenoMap."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để thay đổi những gì MenoMap có thể đọc hoặc ghi: Cài đặt → Sức khỏe → Truy cập dữ liệu & thiết bị → MenoMap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需更改 MenoMap 可以读取或写入的内容：“设置”→“健康”→“数据访问与设备”→ MenoMap。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要更改 MenoMap 可讀取或寫入的內容：「設定」→「健康」→「資料取用權限與裝置」→ MenoMap。"
          }
        }
      }
    },
