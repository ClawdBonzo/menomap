        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca hangi notları gördüğünü değiştirir. MenoMap bunu asla senin yerine belirlemeye çalışmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це змінює лише те, які нотатки ти бачиш. MenoMap ніколи не намагається вирішити це за тебе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này chỉ thay đổi những ghi chú bạn thấy. MenoMap không bao giờ quyết định điều này thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它只会改变你看到的笔记。MenoMap 从不试图替你做这个判断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這只會改變你看到的筆記內容。MenoMap 絕不會試圖替你判斷。"
          }
        }
      }
    },
    "It stays on your iPhone. Nothing is uploaded. You can export or delete everything from You → Privacy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى على الـiPhone الخاص بكِ. لا يُرفع أي شيء. يمكنكِ تصدير كل شيء أو حذفه من ملفّي ← الخصوصية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstává na tvém iPhonu. Nic se nenahrává. Všechno můžeš exportovat nebo smazat v Já → Soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bliver på din iPhone. Intet uploades. Du kan eksportere eller slette alt under Dig → Privatliv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleiben auf deinem iPhone. Nichts wird hochgeladen. Du kannst alles unter Ich → Datenschutz exportieren oder löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μένει στο iPhone σου. Τίποτα δεν ανεβαίνει στο διαδίκτυο. Μπορείς να κάνεις εξαγωγή ή διαγραφή όλων από Εσύ → Απόρρητο."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays on your iPhone. Nothing is uploaded. You can export or delete everything from You → Privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en tu iPhone. No se sube nada. Puedes exportarlo o eliminarlo todo desde Tú → Privacidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en tu iPhone. No se sube nada. Puedes exportar o eliminar todo desde Tú → Privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedot pysyvät iPhonessasi. Mitään ei ladata minnekään. Voit viedä tai poistaa kaiken kohdassa Sinä → Tietosuoja."
