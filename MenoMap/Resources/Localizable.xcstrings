    "Scroll to Available Apps and tap Install next to MenoMap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّري إلى التطبيقات المتوفرة واضغطي على تثبيت بجانب MenoMap."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjeď na Dostupné aplikace a klepni na Instalovat vedle MenoMap."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rul ned til Tilgængelige apps, og tryk på Installer ud for MenoMap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle zu „Verfügbare Apps“ und tippe neben MenoMap auf „Installieren“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κύλισε στις Διαθέσιμες εφαρμογές και άγγιξε Εγκατάσταση δίπλα στο MenoMap."
          }
        },
        "en-GB" : {
          "stringUnit" : {
