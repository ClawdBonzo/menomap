    "Tag a few surges (alcohol, heat, stress…) and your top three land here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضعي وسومًا على بضع موجات (الكحول، الجو الحار، التوتر…) وستظهر هنا الوسوم الثلاثة الأولى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označ několik vln štítky (alkohol, horko, stres…) a tvoje tři nejčastější se objeví tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marker et par bølger (alkohol, varme, stress…), så lander dine top tre her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere ein paar Wellen (Alkohol, Hitze, Stress …), und deine drei häufigsten landen hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε ετικέτες σε μερικά κύματα (αλκοόλ, ζέστη, στρες…) και οι τρεις πιο συχνές θα εμφανιστούν εδώ."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag a few surges (alcohol, heat, stress…) and your top three land here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta unas cuantas oleadas (alcohol, calor, estrés…) y aquí aparecerán tus tres principales."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta algunas oleadas (alcohol, calor, estrés…) y aquí aparecerán tus tres principales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tunniste muutamaan aaltoon (alkoholi, kuumuus, stressi…), niin kolme yleisintä näkyy tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquetez quelques vagues (alcool, chaleur, stress…) et vos trois étiquettes principales apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תייגי כמה גלים (אלכוהול, חום, לחץ…), ושלוש התגיות המובילות שלך יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ लहरों को टैग करें (शराब, गर्म माहौल, तनाव…) और आपके टॉप तीन टैग यहाँ दिखेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označi nekoliko valova (alkohol, vrućina, stres…) i ovdje će se pojaviti tvoje tri najčešće oznake."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Címkézz meg néhány hullámot (alkohol, hőség, stressz…), és ide kerül a három leggyakoribb."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri tag pada beberapa gelombang (alkohol, udara panas, stres…) dan tiga teratasmu muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un tag a qualche ondata (alcol, caldo, stress…) e i tuoi tre più frequenti compariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかのほてりにタグ（お酒、暑さ、ストレスなど）をつけると、上位3つがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열감 몇 개에 태그(음주, 더위, 스트레스…)를 달면 상위 3개가 여기에 나타나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandakan beberapa gelombang (alkohol, cuaca panas, tekanan…) dan tiga yang teratas akan muncul di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk noen bølger (alkohol, varme, stress …), så havner de tre vanligste her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag een paar golven (alcohol, warmte, stress…) en je top drie verschijnt hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz tagami kilka fal (alkohol, gorąco, stres…), a trzy najczęstsze pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque tags em algumas ondas (álcool, calor, estresse…) e as três principais aparecem aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põe etiquetas em algumas ondas (álcool, calor, stress…) e as três principais aparecem aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
