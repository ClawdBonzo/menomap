        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det endrer bare hvilke notater du ser. MenoMap prøver aldri å avgjøre dette for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
