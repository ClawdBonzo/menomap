    "Yours starts filling in with your first surge. Most people see their first pattern in about two weeks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ خريطتكِ بالامتلاء مع أول موجة. يرى معظم الناس أول نمط لهم بعد نحو أسبوعين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje mapa se začne plnit s první vlnou. Většina lidí uvidí svůj první vzorec zhruba po dvou týdnech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kort begynder at tage form med din første bølge. De fleste ser deres første mønster efter cirka to uger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine füllt sich mit deiner ersten Welle. Die meisten sehen ihr erstes Muster nach etwa zwei Wochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο δικός σου αρχίζει να γεμίζει με το πρώτο σου κύμα. Τα περισσότερα άτομα βλέπουν το πρώτο τους μοτίβο σε περίπου δύο εβδομάδες."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yours starts filling in with your first surge. Most people see their first pattern in about two weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tuyo empieza a llenarse con tu primera oleada. La mayoría de la gente ve su primer patrón en unas dos semanas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tuyo empieza a llenarse con tu primera oleada. La mayoría de las personas ve su primer patrón en unas dos semanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omasi alkaa täyttyä ensimmäisestä aallostasi. Useimmat näkevät ensimmäisen kuvionsa noin kahdessa viikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vôtre commence à se remplir dès votre première vague. La plupart des gens voient leur première tendance au bout d’environ deux semaines."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפה שלך תתחיל להתמלא עם הגל הראשון. רוב האנשים רואים את הדפוס הראשון שלהם אחרי כשבועיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मैप आपकी पहली लहर के साथ भरना शुरू होता है। ज़्यादातर लोगों को लगभग दो हफ़्ते में पहला पैटर्न दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja se počinje puniti prvim valom. Većina ljudi prvi obrazac vidi za otprilike dva tjedna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tiéd az első hullámoddal kezd megtelni. A legtöbben nagyjából két hét után látják az első mintázatukat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petamu mulai terisi dengan gelombang pertamamu. Kebanyakan orang melihat pola pertama mereka dalam sekitar dua minggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua inizia a riempirsi con la prima ondata. La maggior parte delle persone vede la prima ricorrenza in circa due settimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のほてりを記録すると、あなたのマップが埋まり始めます。多くの人は、2週間ほどで最初の傾向が見えてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 열감을 기록하면 채워지기 시작해요. 대부분 2주쯤 지나면 첫 패턴을 보게 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peta anda mula terisi dengan gelombang pertama anda. Kebanyakan orang melihat corak pertama mereka dalam kira-kira dua minggu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt begynner å fylles inn med din første bølge. De fleste ser sitt første mønster etter omtrent to uker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De jouwe vult zich vanaf je eerste golf. De meeste mensen zien hun eerste patroon na ongeveer twee weken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja zacznie się wypełniać od pierwszej fali. Większość osób widzi pierwszy wzorzec po około dwóch tygodniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu começa a se preencher com a sua primeira onda. A maioria das pessoas vê o primeiro padrão em cerca de duas semanas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu mapa começa a preencher-se com a tua primeira onda. A maioria das pessoas vê o primeiro padrão ao fim de cerca de duas semanas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ta începe să se umple cu primul val. Majoritatea oamenilor își văd primul tipar în aproximativ două săptămâni."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja sa začne zapĺňať prvou vlnou. Väčšina ľudí uvidí prvý vzorec asi po dvoch týždňoch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din börjar fyllas i med din första våg. De flesta ser sitt första mönster efter ungefär två veckor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ของคุณจะเริ่มเติมเต็มตั้งแต่ระลอกร้อนแรก คนส่วนใหญ่เห็นรูปแบบแรกในราวสองสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seninki ilk dalganla dolmaya başlar. Çoğu kişi ilk örüntüsünü yaklaşık iki haftada görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя почне заповнюватися з першою хвилею. Більшість людей бачить першу закономірність приблизно за два тижні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản đồ của bạn bắt đầu có dữ liệu từ cơn nóng đầu tiên. Phần lớn mọi người thấy mẫu hình đầu tiên sau khoảng hai tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的图会从第一次热浪开始填满。大多数人在大约两周后会看到第一个规律。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄第一次熱浪後，你的圖就會開始填滿。大多數人大約兩週就會看到第一個規律。"
          }
        }
      }
    },
