        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus registros: %1$lld oleadas en los %2$lld días registrados de antes, %3$lld en los %4$lld días registrados de durante. Es lo que registraste, no una prueba de la causa."
