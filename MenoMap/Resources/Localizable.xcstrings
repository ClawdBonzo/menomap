        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी एंट्री: पहले के %2$lld दर्ज दिनों में %1$lld लहरें, दौरान के %4$lld दर्ज दिनों में %3$lld। यह वही है जो आपने दर्ज किया, कारण का सबूत नहीं।"
