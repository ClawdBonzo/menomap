          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkintäsi: aaltoja ennen %1$lld (kirjattuja päiviä %2$lld), aikana %3$lld (kirjattuja päiviä %4$lld). Tämä on sitä, mitä kirjasit, ei todiste syystä."
