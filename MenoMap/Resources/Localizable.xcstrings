    "Touch and hold the Home Screen, tap Edit, then Add Widget." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسي الشاشة الرئيسية مطولًا، واضغطي على تعديل، ثم إضافة أداة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst na ploše, klepni na Upravit a pak na Přidat widget."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på hjemmeskærmen, tryk på Rediger og derefter på Tilføj widget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Home-Bildschirm gedrückt, tippe auf „Bearbeiten“ und dann auf „Widget hinzufügen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα την οθόνη Αφετηρίας, άγγιξε «Επεξεργασία» και μετά «Προσθήκη widget»."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Home Screen, tap Edit, then Add Widget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la pantalla de inicio, toca Editar y luego Añadir widget."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada la pantalla de inicio, toca Editar y luego Agregar widget."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina pitkään Koti-valikkoa, napauta Muokkaa ja sitten Lisää widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez longuement l’écran d’accueil, touchez Modifier, puis Ajouter un widget."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "געי והחזיקי במסך הבית, הקישי על ״עריכה״ ואז על ״הוספת וידג׳ט״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम स्क्रीन को टच और होल्ड करें, “संपादित करें” पर टैप करें, फिर “विजेट जोड़ें” पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni i zadrži početni zaslon, dodirni Uredi, zatim Dodaj widget."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd megérintve a Főképernyőt, koppints a Szerkesztés, majd a Widget hozzáadása lehetőségre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Layar Utama, ketuk Edit, lalu Tambah Widget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto sulla schermata Home, tocca Modifica, poi Aggiungi widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面を長押しし、「編集」→「ウィジェットを追加」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면을 길게 터치하고 편집을 탭한 다음 위젯 추가를 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Skrin Utama, ketik Edit, kemudian Tambah Widget."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på Hjem-skjermen, trykk på Rediger og deretter på Legg til widget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op het beginscherm, tik op Wijzig en daarna op Voeg widget toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj ekran główny, stuknij Edycja, a potem Dodaj widżet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionada a Tela de Início, toque em Editar e depois em Adicionar Widget."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca e mantém o dedo no ecrã principal, toca em Editar e depois em Adicionar widget."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat pe ecranul principal, apasă Editați, apoi Adăugați un widget."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst na ploche, ťukni na Upraviť a potom na Pridať widget."
          }
        },
