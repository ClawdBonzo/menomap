          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till datumet så gör MenoMap dina anteckningar klara i tid. Valfritt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มวันนัด แล้ว MenoMap จะเตรียมสรุปของคุณให้พร้อมทันเวลา ไม่บังคับ"
          }
