    "Even once, even light." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ولو مرة واحدة، ولو كان خفيفًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I jednou, i slabé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også bare én gang, også hvis den er let."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch nur einmal, auch nur leicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και μία φορά, ακόμη και λίγη."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even once, even light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque sea una sola vez, aunque sea leve."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque sea una sola vez, aunque sea leve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka vain kerran, vaikka vähäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même une seule fois, même légers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפילו פעם אחת, אפילו אם הוא קל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चाहे एक बार हो, चाहे हल्का हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čak i jednom, čak i slabo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akár egyszeri, akár enyhe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski hanya sekali, meski hanya sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche una sola volta, anche leggero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たとえ1回でも、たとえ少量でも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단 한 번이라도, 양이 적더라도."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walaupun sekali, walaupun sedikit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv én gang, selv om den er svak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelfs één keer, zelfs als het weinig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet jednorazowe, nawet niewielkie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo uma única vez, mesmo leve."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo que só uma vez, mesmo que ligeira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiar și o singură dată, chiar și ușoară."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aj keď len raz, aj keď slabé."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även en enda gång, även lätt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้เพียงครั้งเดียว แม้เพียงเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez bile olsa, az bile olsa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навіть одноразова, навіть слабка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù chỉ một lần, dù chỉ ít."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪怕只有一次，哪怕量很少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使只有一次、即使量很少。"
          }
        }
      }
    },
