        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar çoğu zaman birkaç dakika içinde doruğa ulaşıp hafifler. Bu bir tıbbi tedavi değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часто вони досягають піку й стихають за кілька хвилин. Це не медичне лікування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những cơn này thường lên đỉnh rồi dịu đi trong vài phút. Đây không phải là điều trị y tế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种感觉通常在几分钟内达到高峰，然后缓解。这不是医学治疗。"
