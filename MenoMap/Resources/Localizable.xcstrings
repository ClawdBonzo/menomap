    "Could anything besides menopause be causing my night sweats?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يمكن أن يكون لتعرّقي الليلي سبب غير انقطاع الطمث؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Může moje noční pocení způsobovat něco jiného než přechod?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan noget andet end overgangsalderen være årsag til min nattesved?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Könnte etwas anderes als die Wechseljahre mein nächtliches Schwitzen verursachen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα μπορούσε κάτι άλλο εκτός από την εμμηνόπαυση να προκαλεί τις νυχτερινές εφιδρώσεις μου;"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could anything besides menopause be causing my night sweats?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Podría haber algo, aparte de la menopausia, que cause mis sudores nocturnos?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algo además de la menopausia podría estar causando mis sudores nocturnos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voisiko yöhikoiluni johtua jostain muusta kuin vaihdevuosista?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes sueurs nocturnes pourraient-elles avoir une autre cause que la ménopause ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם משהו אחר מלבד גיל המעבר יכול לגרום להזעות הלילה שלי?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या रजोनिवृत्ति के अलावा कुछ और भी मेरे रात के पसीने की वजह हो सकता है?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Može li nešto osim menopauze uzrokovati moje noćno znojenje?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okozhatja más is az éjszakai izzadásomat, nem csak a menopauza?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mungkinkah ada penyebab lain selain menopause untuk keringat malam saya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mie sudorazioni notturne potrebbero avere una causa diversa dalla menopausa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寝汗の原因として、更年期以外のものは考えられますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제 야간 발한이 갱년기 말고 다른 원인 때문일 수도 있나요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah perkara lain selain menopaus mungkin menyebabkan saya berpeluh pada waktu malam?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan noe annet enn overgangsalderen være årsaken til nattesvetten min?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan iets anders dan de overgang mijn nachtelijk zweten veroorzaken?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy moje nocne poty mogą mieć inną przyczynę niż menopauza?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo além da menopausa pode estar causando meus suores noturnos?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os meus suores noturnos podem ter outra causa além da menopausa?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar putea altceva decât menopauza să-mi provoace transpirațiile nocturne?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môže moje nočné potenie spôsobovať aj niečo iné ako menopauza?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan något annat än klimakteriet orsaka mina nattsvettningar?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหงื่อออกตอนกลางคืนของฉันอาจเกิดจากสาเหตุอื่นนอกจากวัยหมดประจำเดือนได้ไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece terlemelerime menopoz dışında bir şey neden olabilir mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи може щось, крім менопаузи, спричиняти мою нічну пітливість?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liệu có nguyên nhân nào khác ngoài mãn kinh gây ra đổ mồ hôi ban đêm của tôi không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了更年期，还有其他原因可能导致我夜间盗汗吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了更年期，還有什麼可能導致我夜間盜汗？"
          }
        }
      }
    },
