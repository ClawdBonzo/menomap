        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통 몇 분 안에 절정에 이르렀다가 가라앉아요. 이것은 의학적 치료가 아니에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelombang ini selalunya memuncak dan reda dalam masa satu atau dua minit. Ini bukan rawatan perubatan."
