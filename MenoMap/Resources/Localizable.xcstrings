            "value" : "Οι καταχωρίσεις σου. Κύματα πριν: %1$lld σε %2$lld ημέρες καταγραφής. Κατά τη διάρκεια: %3$lld σε %4$lld ημέρες καταγραφής. Αυτό είναι ό,τι κατέγραψες, όχι απόδειξη αιτίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your entries: %1$lld surges in the %2$lld logged days before, %3$lld in the %4$lld logged days during. That's what you logged, not proof of cause."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your entries: %1$lld surges in the %2$lld logged days before, %3$lld in the %4$lld logged days during. That's what you logged, not proof of cause."
          }
