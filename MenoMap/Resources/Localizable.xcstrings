            "value" : "वैकल्पिक: शॉर्टकट ऐप में एक ऑटोमेशन जोड़ें: स्लीप फ़ोकस चालू होने पर → रात का पहरा चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neobavezno: u Prečacima dodaj automatizaciju: kad se uključi fokus Spavanje → Uključi Noćnu stražu."
          }
        },
        "hu" : {
          "stringUnit" : {
