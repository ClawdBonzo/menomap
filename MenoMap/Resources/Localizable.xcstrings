    "Wellness tracker, not a diagnosis. Check with a clinician before making medical decisions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أداة لتتبّع العافية، وليست تشخيصًا. راجعي طبيبًا قبل اتخاذ قرارات طبية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace pro sledování zdraví a pohody, ne diagnóza. Než uděláš zdravotní rozhodnutí, poraď se s lékařem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et wellness-værktøj til registrering, ikke en diagnose. Tal med en læge, før du træffer medicinske beslutninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellness-Tracker, keine Diagnose. Sprich mit einer Ärztin oder einem Arzt, bevor du medizinische Entscheidungen triffst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμογή παρακολούθησης ευεξίας, όχι διάγνωση. Συμβουλέψου γιατρό πριν πάρεις ιατρικές αποφάσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellness tracker, not a diagnosis. Check with a clinician before making medical decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramienta de seguimiento del bienestar, no un diagnóstico. Consulta con un profesional sanitario antes de tomar decisiones médicas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramienta de seguimiento del bienestar, no un diagnóstico. Consulta con un profesional de la salud antes de tomar decisiones médicas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvinvoinnin seurantasovellus, ei diagnoosi. Keskustele lääkärin kanssa ennen lääketieteellisiä päätöksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outil de suivi du bien-être, pas un diagnostic. Consultez un médecin avant de prendre des décisions médicales."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כלי למעקב אחר רווחה, לא אבחנה. התייעצי עם רופא/ה לפני קבלת החלטות רפואיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेलनेस ट्रैकर, निदान नहीं। मेडिकल फ़ैसले लेने से पहले डॉक्टर से सलाह लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija za praćenje dobrobiti, ne dijagnoza. Prije medicinskih odluka posavjetuj se s liječnikom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellness célú követő, nem diagnózis. Orvosi döntések előtt egyeztess orvossal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat pencatat kesehatan umum, bukan diagnosis. Tanyakan ke dokter sebelum mengambil keputusan medis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoraggio del benessere, non una diagnosi. Consulta un medico prima di prendere decisioni mediche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェルネス記録であり、診断ではありません。医療上の判断をする前に、医師に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 관리 기록 도구이며, 진단이 아니에요. 의학적 결정을 내리기 전에 의료진과 상의하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penjejak kesejahteraan, bukan diagnosis. Rujuk doktor sebelum membuat keputusan perubatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøy for å følge med på egen helse, ikke en diagnose. Rådfør deg med en lege før du tar medisinske beslutninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App om je welzijn bij te houden, geen diagnose. Overleg met een arts voordat je medische beslissingen neemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja do monitorowania samopoczucia, a nie diagnoza. Przed podjęciem decyzji medycznych skonsultuj się z lekarzem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App de acompanhamento de bem-estar, não um diagnóstico. Consulte um profissional de saúde antes de tomar decisões médicas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
