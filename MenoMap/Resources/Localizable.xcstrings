    "It turns on by itself when you do your evening check-in or open MenoMap near bedtime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل تلقائيًا عند إجراء تسجيل المساء أو فتح MenoMap قرب وقت النوم."
