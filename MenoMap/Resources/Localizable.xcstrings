    "Entered by the user. Not a diagnosis. Not a complete medical record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات أدخلها المستخدم. ليست تشخيصًا. ليست سجلًا طبيًا كاملًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje zadala uživatelka. Nejde o diagnózu. Nejde o úplnou zdravotní dokumentaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtastet af brugeren. Ikke en diagnose. Ikke en komplet journal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Person selbst eingetragen. Keine Diagnose. Keine vollständige Krankenakte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταχωρίστηκε από τη χρήστρια. Δεν αποτελεί διάγνωση. Δεν είναι πλήρης ιατρικός φάκελος."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entered by the user. Not a diagnosis. Not a complete medical record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos introducidos por la usuaria. No es un diagnóstico. No es un historial médico completo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos ingresados por la persona usuaria. No son un diagnóstico. No son un expediente médico completo."
