          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вентилятор, відчинене вікно або нижча температура на термостаті вночі — протягом двох тижнів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quạt, mở cửa sổ hoặc hạ nhiệt độ điều hòa vào ban đêm, trong hai tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上开风扇、开窗或调低室温，坚持两周。"
