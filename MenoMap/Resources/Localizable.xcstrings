    "Puts a one-tap night sweat button on your Lock Screen until morning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع زر تعرّق ليلي بنقرة واحدة على شاشة القفل حتى الصباح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá na zamknutou obrazovku tlačítko pro noční pocení na jedno klepnutí, až do rána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter en nattesved-knap med ét tryk på låseskærmen indtil morgen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt bis zum Morgen eine Nachtschweiß-Taste für ein Tippen auf deinen Sperrbildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάζει στην οθόνη κλειδώματος ένα κουμπί για νυχτερινή εφίδρωση, με ένα πάτημα, ως το πρωί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts a one-tap night sweat button on your Lock Screen until morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone un botón de sudores nocturnos de un solo toque en la pantalla bloqueada hasta la mañana."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone un botón de sudor nocturno de un toque en tu pantalla bloqueada hasta la mañana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo yhden napautuksen yöhikoilupainikkeen lukitulle näytölle aamuun asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place un bouton sueurs nocturnes en un toucher sur l’écran verrouillé jusqu’au matin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף כפתור הזעת לילה בהקשה אחת למסך הנעילה, עד הבוקר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह तक आपकी लॉक स्क्रीन पर रात के पसीने का एक-टैप बटन रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do jutra stavlja na zaključani zaslon gumb kojim jednim dodirom bilježiš noćno znojenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy koppintásos éjszakai izzadás gombot tesz a zárolási képernyőre reggelig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaruh tombol keringat malam sekali ketuk di Layar Terkunci sampai pagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette sulla schermata di blocco un pulsante per le sudorazioni notturne, attivo fino al mattino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝まで、ロック画面にワンタップの寝汗ボタンを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침까지 잠금 화면에 한 번 탭하는 야간 발한 버튼을 둬요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meletakkan butang peluh malam satu ketikan pada Skrin Kunci anda sehingga pagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger en ettrykksknapp for nattesvette på låst skjerm fram til morgenen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet tot de ochtend een knop voor nachtelijk zweten op je toegangsscherm, met één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieszcza na ekranie blokady przycisk nocnych potów, działający jednym stuknięciem do rana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca um botão de suor noturno de um toque na Tela Bloqueada até de manhã."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca no ecrã bloqueado um botão de suores noturnos, a um toque, até de manhã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune pe ecranul de blocare un buton pentru transpirații nocturne, la o atingere, până dimineața."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridá na zamknutú obrazovku tlačidlo pre nočné potenie na jedno ťuknutie, až do rána."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger en knapp för nattsvettningar på låsskärmen till morgonen, ett tryck räcker."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางปุ่มบันทึกเหงื่อออกตอนกลางคืนแบบแตะครั้งเดียวไว้บนหน้าจอล็อคจนถึงเช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli Ekranına sabaha kadar tek dokunuşluk bir gece terlemesi düğmesi koyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розміщує на замкненому екрані кнопку нічної пітливості, що працює одним торканням до ранку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt nút đổ mồ hôi đêm một chạm trên Màn hình khóa đến sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
