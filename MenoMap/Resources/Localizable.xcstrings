    "Try one change for two weeks and see what your own entries show." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّبي تغييرًا واحدًا لمدة أسبوعين وانظري ما تُظهره إدخالاتكِ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzkoušej jednu změnu po dva týdny a podívej se, co ukážou tvoje vlastní záznamy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv én ændring i to uger, og se, hvad dine egne registreringer viser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probier zwei Wochen lang eine Veränderung aus und sieh, was deine eigenen Einträge zeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκίμασε μία αλλαγή για δύο εβδομάδες και δες τι δείχνουν οι δικές σου καταχωρίσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try one change for two weeks and see what your own entries show."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba un cambio durante dos semanas y mira lo que muestran tus propios registros."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
