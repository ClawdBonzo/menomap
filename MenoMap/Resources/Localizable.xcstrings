          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia to tylko to, które notatki widzisz. MenoMap nigdy nie próbuje decydować o tym za ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso só muda quais notas você vê. O MenoMap nunca tenta decidir isso por você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só muda as notas que vês. O MenoMap nunca tenta decidir isto por ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă doar notițele pe care le vezi. MenoMap nu încearcă niciodată să decidă asta în locul tău."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mení to len to, ktoré poznámky vidíš. MenoMap sa to nikdy nesnaží rozhodnúť za teba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ändrar bara vilka texter du ser. MenoMap försöker aldrig avgöra det åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งนี้เปลี่ยนเพียงเนื้อหาที่คุณเห็น MenoMap ไม่เคยพยายามตัดสินเรื่องนี้แทนคุณ"
