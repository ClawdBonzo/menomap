        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez un changement pendant deux semaines et voyez ce que montrent vos propres saisies."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נסי שינוי אחד במשך שבועיים וראי מה הרישומים שלך מראים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो हफ़्ते तक एक बदलाव आज़माएँ और देखें कि आपकी अपनी एंट्री क्या दिखाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
