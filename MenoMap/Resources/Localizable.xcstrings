    "Appointments are short. Memory is kind. Notes are exact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المواعيد قصيرة. والذاكرة رحيمة. أما الملاحظات فدقيقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
