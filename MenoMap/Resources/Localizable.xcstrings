    "Add what you take, including HRT, non-hormonal options and supplements." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفي ما تتناولينه، بما في ذلك العلاج الهرموني التعويضي، والخيارات غير الهرمونية، والمكمّلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej, co užíváš, včetně HRT, nehormonálních možností a doplňků stravy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj det, du tager, også hormonbehandling, ikke-hormonelle muligheder og kosttilskud."
