    "Fan, window or a lower thermostat at night, for two weeks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مروحة أو نافذة أو خفض منظّم الحرارة ليلًا، لمدة أسبوعين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilátor, okno nebo nižší teplota na termostatu v noci, po dva týdny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilator, vindue eller lavere termostat om natten, i to uger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilator, Fenster oder nachts die Heizung runter, zwei Wochen lang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανεμιστήρας, ανοιχτό παράθυρο ή χαμηλότερος θερμοστάτης τη νύχτα, για δύο εβδομάδες."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan, window or a lower thermostat at night, for two weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilador, ventana o termostato más bajo por la noche, durante dos semanas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilador, ventana o el termostato más bajo en la noche, durante dos semanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuuletin, ikkuna tai matalampi lämpötila yöksi, kahden viikon ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilateur, fenêtre ou thermostat plus bas la nuit, pendant deux semaines."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאוורר, חלון פתוח או מזגן על טמפרטורה נמוכה יותר בלילה, במשך שבועיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रात में पंखा, खुली खिड़की या AC का कम तापमान, दो हफ़्ते तक।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilator, prozor ili niža temperatura na termostatu noću, dva tjedna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilátor, nyitott ablak vagy éjszakára lejjebb vett termosztát, két hétig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kipas angin, jendela terbuka, atau suhu AC lebih rendah di malam hari, selama dua minggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilatore, finestra o termostato più basso di notte, per due settimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜は扇風機、窓、低めの室温設定で。2週間続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2주 동안 밤에 선풍기, 창문 열기 또는 낮은 실내 온도."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kipas, tingkap atau suhu penyaman udara yang lebih rendah pada waktu malam, selama dua minggu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vifte, vindu eller lavere temperatur på termostaten om natten, i to uker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilator, raam open of de thermostaat lager 's nachts, twee weken lang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wentylator, okno lub niższa temperatura na termostacie w nocy, przez dwa tygodnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilador, janela aberta ou ar-condicionado mais frio à noite, por duas semanas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventoinha, janela aberta ou termóstato mais baixo à noite, durante duas semanas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilator, geam deschis sau termostat mai jos noaptea, timp de două săptămâni."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilátor, okno alebo nižšia teplota na termostate v noci, počas dvoch týždňov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fläkt, öppet fönster eller lägre temperatur på natten, i två veckor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดพัดลม เปิดหน้าต่าง หรือตั้งแอร์ให้เย็นขึ้นตอนกลางคืน เป็นเวลาสองสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
