        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykle narastają i słabną w ciągu kilku minut. To nie jest leczenie medyczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas costumam chegar ao pico e passar em poucos minutos. Isto não é um tratamento médico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
