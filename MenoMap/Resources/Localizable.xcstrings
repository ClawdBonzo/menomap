    "A one-tap night sweat button on your Lock Screen, from bedtime until morning. No unlocking, no bright screen at 3am." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر للتعرّق الليلي بنقرة واحدة على شاشة القفل، من وقت النوم حتى الصباح. دون فتح القفل، ودون شاشة ساطعة في الثالثة فجرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko na jedno klepnutí pro noční pocení na zamknuté obrazovce, od večerky do rána. Žádné odemykání, žádná jasná obrazovka ve tři ráno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nattesved-knap på låseskærmen, ét tryk, fra sengetid til morgen. Ingen oplåsning, ingen skarp skærm kl. 3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nachtschweiß-Taste auf dem Sperrbildschirm, mit einem Tippen, von der Schlafenszeit bis zum Morgen. Kein Entsperren, kein greller Bildschirm um 3 Uhr nachts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κουμπί στην οθόνη κλειδώματος για νυχτερινή εφίδρωση, με ένα πάτημα, από την ώρα του ύπνου ως το πρωί. Χωρίς ξεκλείδωμα, χωρίς φωτεινή οθόνη στις 3 τα ξημερώματα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A one-tap night sweat button on your Lock Screen, from bedtime until morning. No unlocking, no bright screen at 3am."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón de sudores nocturnos en la pantalla bloqueada, de un solo toque, desde la hora de dormir hasta la mañana. Sin desbloquear y sin pantallas brillantes a las 3 de la madrugada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón de sudor nocturno de un toque en tu pantalla bloqueada, desde la hora de dormir hasta la mañana. Sin desbloquear, sin pantalla brillante a las 3 de la mañana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhden napautuksen yöhikoilupainike lukitulla näytöllä nukkumaanmenosta aamuun. Ei lukituksen avaamista, ei kirkasta näyttöä kello kolmelta yöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton sueurs nocturnes en un seul toucher sur l’écran verrouillé, du coucher jusqu’au matin. Sans déverrouiller, sans écran éblouissant à 3 h du matin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כפתור הזעת לילה בהקשה אחת במסך הנעילה, משעת השינה ועד הבוקר. בלי לבטל נעילה, בלי מסך בוהק ב-3 לפנות בוקר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी लॉक स्क्रीन पर रात के पसीने का एक-टैप बटन, सोने के समय से सुबह तक। न अनलॉक करना, न रात 3 बजे चमकती स्क्रीन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumb na zaključanom zaslonu kojim jednim dodirom bilježiš noćno znojenje, od odlaska na spavanje do jutra. Bez otključavanja, bez jarkog zaslona u 3 ujutro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy koppintásos éjszakai izzadás gomb a zárolási képernyőn lefekvéstől reggelig. Nem kell feloldani a telefont, és nincs vakító képernyő hajnali 3-kor."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol keringat malam sekali ketuk di Layar Terkunci, dari waktu tidur hingga pagi. Tanpa membuka kunci, tanpa layar terang pukul 3 pagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pulsante per le sudorazioni notturne sulla schermata di blocco, da quando vai a letto fino al mattino. Senza sbloccare, senza schermo accecante alle 3 di notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就寝時から朝まで、ロック画面にワンタップの寝汗ボタンを表示します。ロック解除は不要で、午前3時にまぶしい画面を見ることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취침부터 아침까지 잠금 화면에 한 번만 탭하면 되는 야간 발한 버튼이 있어요. 잠금 해제도, 새벽 3시의 밝은 화면도 필요 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butang peluh malam satu ketikan pada Skrin Kunci anda, dari waktu tidur hingga pagi. Tidak perlu membuka kunci, tiada skrin terang pada pukul 3 pagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ettrykksknapp for nattesvette på låst skjerm, fra leggetid til morgen. Ingen opplåsing, ingen skarp skjerm klokka tre om natten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een knop voor nachtelijk zweten op je toegangsscherm, met één tik, van bedtijd tot de ochtend. Niet ontgrendelen, geen fel scherm om 3 uur 's nachts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk nocnych potów na ekranie blokady, działający jednym stuknięciem od pory snu do rana. Bez odblokowywania, bez jasnego ekranu o trzeciej w nocy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão de suor noturno de um toque na Tela Bloqueada, da hora de dormir até de manhã. Sem desbloquear, sem tela acesa às 3h da manhã."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão de suores noturnos no ecrã bloqueado, a um toque, desde a hora de deitar até de manhã. Sem desbloquear, sem ecrã a brilhar às 3 da manhã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un buton pentru transpirații nocturne pe ecranul de blocare, la o singură atingere, de la ora de culcare până dimineața. Fără deblocare, fără ecran luminos la 3 noaptea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačidlo pre nočné potenie na zamknutej obrazovke, na jedno ťuknutie, od času spánku do rána. Bez odomykania, bez jasnej obrazovky o tretej ráno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En knapp för nattsvettningar på låsskärmen, ett tryck räcker, från läggdags till morgonen. Ingen upplåsning, ingen skarp skärm klockan tre på natten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มบันทึกเหงื่อออกตอนกลางคืนแบบแตะครั้งเดียวบนหน้าจอล็อค ตั้งแต่เวลาเข้านอนจนถึงเช้า ไม่ต้องปลดล็อค ไม่มีหน้าจอสว่างจ้าตอนตีสาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatma saatinden sabaha kadar Kilitli Ekranında tek dokunuşluk bir gece terlemesi düğmesi. Kilidi açmak yok, gece 3'te parlak ekran yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка нічної пітливості на замкненому екрані — одним торканням, від часу сну до ранку. Без розблокування, без яскравого екрана о третій ночі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút đổ mồ hôi đêm một chạm trên Màn hình khóa, từ giờ đi ngủ đến sáng. Không cần mở khóa, không có màn hình chói lúc 3 giờ sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕上的一键夜间盗汗按钮，从就寝到早晨。无需解锁，凌晨 3 点也不用面对刺眼的屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從就寢到早上，鎖定畫面上都有一個點一下就能記錄的夜間盜汗按鈕。不必解鎖，凌晨 3 點也不會被亮螢幕刺眼。"
          }
        }
      }
    },
