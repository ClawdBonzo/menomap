    "Heat scale from calm to hot. Each cell also shows its number of surges." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقياس الحرارة من الهادئ إلى الحار. تعرض كل خانة أيضًا عدد موجاتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepelná škála od klidu po horko. Každé políčko ukazuje i počet vln."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmeskala fra rolig til varm. Hver celle viser også antallet af bølger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitzeskala von ruhig bis heiß. Jedes Feld zeigt auch die Anzahl seiner Wellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλίμακα από ηρεμία έως καύσωνα. Κάθε κελί δείχνει επίσης τον αριθμό των κυμάτων του."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat scale from calm to hot. Each cell also shows its number of surges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de calor, de calma a calor. Cada casilla muestra también su número de oleadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de calor, de calma a caliente. Cada celda también muestra su número de oleadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämpöasteikko tyynestä kuumaan. Jokaisessa ruudussa näkyy myös sen aaltojen määrä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échelle de chaleur, du calme au chaud. Chaque case indique aussi son nombre de vagues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סולם חום מ״רגוע״ עד ״חם״. בכל משבצת מופיע גם מספר הגלים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शांत से गर्म तक हीट स्केल। हर खाने में उसकी लहरों की संख्या भी दिखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplinska ljestvica od mirnog do vrućeg. Svako polje prikazuje i broj valova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hőskála a nyugodttól a forróig. Minden cella a hullámok számát is mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala panas dari tenang hingga panas. Setiap sel juga menunjukkan jumlah gelombangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scala del calore da calma a caldo. Ogni casella mostra anche il numero di ondate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかから熱いまでの色の目盛りです。各マスには、ほてりの回数も表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평온에서 뜨거움까지의 열감 척도예요. 각 칸에는 열감 횟수도 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala haba dari tenang hingga panas. Setiap petak juga menunjukkan bilangan gelombangnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heteskala fra rolig til het. Hver rute viser også antall bølger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitteschaal van rustig tot heet. Elk vakje toont ook het aantal golven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala ciepła od spokoju do gorąca. Każde pole pokazuje też liczbę fal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de calor, do calmo ao quente. Cada célula também mostra seu número de ondas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de calor, de calmo a quente. Cada célula mostra também o número de ondas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scara căldurii, de la calm la fierbinte. Fiecare celulă arată și numărul de valuri."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepelná škála od pokojných po horúce dni. Každé políčko ukazuje aj svoj počet vĺn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmeskala från lugnt till hett. Varje ruta visar också antalet vågor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระดับความร้อนจากสงบถึงร้อน แต่ละช่องแสดงจำนวนระลอกร้อนด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakinden sıcağa ısı ölçeği. Her hücre dalga sayısını da gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шкала тепла від спокою до спеки. У кожній клітинці також видно кількість хвиль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thang nhiệt từ dịu đến nóng. Mỗi ô cũng hiển thị số cơn nóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热度色阶从平静到炽热。每个格子也会显示它的热浪次数。"
