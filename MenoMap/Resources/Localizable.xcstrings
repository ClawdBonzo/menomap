    "Three stages, and why the lines between them are blurry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاث مراحل، ولماذا الحدود بينها غير واضحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři fáze a proč jsou hranice mezi nimi rozmazané."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre faser, og hvorfor grænserne mellem dem er uskarpe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Phasen, und warum die Grenzen dazwischen verschwimmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρία στάδια, και γιατί τα όρια ανάμεσά τους είναι θολά."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three stages, and why the lines between them are blurry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres etapas, y por qué los límites entre ellas son difusos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres etapas, y por qué los límites entre ellas son difusos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme vaihetta ja miksi niiden rajat ovat häilyviä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois stades, et pourquoi les frontières entre eux sont floues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלושה שלבים, ולמה הגבולות ביניהם מטושטשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन चरण, और उनके बीच की रेखाएँ धुंधली क्यों हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri faze i zašto su granice među njima nejasne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három szakasz, és miért elmosódottak a határaik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga tahap, dan mengapa batas di antaranya kabur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre fasi, e perché i confini tra loro sono sfumati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つの段階と、その境目があいまいな理由。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세 단계, 그리고 그 경계가 흐릿한 이유."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga peringkat, dan mengapa sempadan antaranya kabur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre faser, og hvorfor grensene mellom dem er uskarpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie fasen, en waarom de grenzen ertussen vaag zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy etapy i dlaczego granice między nimi są nieostre."
