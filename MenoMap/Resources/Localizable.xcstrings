    "Only a clinician can evaluate that. What MenoMap can do is show what you logged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع تقييم ذلك إلا الطبيب. ما يستطيعه MenoMap هو عرض ما سجّلتِه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To může posoudit jen lékař. MenoMap ti může ukázat, co jsi zaznamenala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan kun en læge vurdere. Det, MenoMap kan, er at vise, hvad du har registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann nur eine Ärztin oder ein Arzt beurteilen. MenoMap kann zeigen, was du erfasst hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο ένας γιατρός μπορεί να το αξιολογήσει αυτό. Αυτό που μπορεί να κάνει το MenoMap είναι να δείξει τι κατέγραψες."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a clinician can evaluate that. What MenoMap can do is show what you logged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un profesional sanitario puede valorar eso. Lo que MenoMap puede hacer es mostrarte lo que has registrado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un profesional de la salud puede evaluar eso. Lo que MenoMap puede hacer es mostrarte lo que registraste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain lääkäri voi arvioida sen. MenoMap voi näyttää, mitä olet kirjannut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un médecin peut évaluer cela. Ce que MenoMap peut faire, c’est montrer ce que vous avez noté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק רופא/ה יכול/ה להעריך את זה. מה ש-MenoMap יכול לעשות הוא להראות את מה שתיעדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका आकलन सिर्फ़ डॉक्टर कर सकते हैं। MenoMap बस यह दिखा सकता है कि आपने क्या दर्ज किया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To može procijeniti samo liječnik. MenoMap može pokazati ono što si zabilježila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt csak orvos tudja megítélni. Amit a MenoMap tehet: megmutatja, mit rögzítettél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dokter yang bisa menilai hal itu. Yang bisa dilakukan MenoMap adalah menunjukkan apa yang kamu catat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un medico può valutarlo. Quello che MenoMap può fare è mostrarti ciò che hai registrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それを評価できるのは医師だけです。MenoMapにできるのは、あなたが記録した内容を示すことです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
