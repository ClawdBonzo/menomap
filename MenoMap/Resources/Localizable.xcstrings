      }
    },
    "Add the date. MenoMap shows how ready your notes are and reminds you a week before, the day before and that morning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفي التاريخ. يوضح MenoMap مدى جاهزية ملاحظاتكِ ويذكّركِ قبل أسبوع، وقبل يوم، وفي صباح الموعد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej datum. MenoMap ukáže, jak připravené jsou tvoje poznámky, a připomene ti to týden předem, den předem a ráno v den návštěvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj datoen. MenoMap viser, hvor klar dine noter er, og minder dig om det en uge før, dagen før og samme morgen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag das Datum ein. MenoMap zeigt, wie weit deine Notizen sind, und erinnert dich eine Woche vorher, am Vortag und am Morgen des Termins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε την ημερομηνία. Το MenoMap δείχνει πόσο έτοιμες είναι οι σημειώσεις σου και σου το θυμίζει μία εβδομάδα πριν, την προηγούμενη ημέρα και το ίδιο πρωί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the date. MenoMap shows how ready your notes are and reminds you a week before, the day before and that morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la fecha. MenoMap te muestra lo preparadas que están tus notas y te lo recuerda una semana antes, el día antes y esa misma mañana."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega la fecha. MenoMap te muestra qué tan listas están tus notas y te lo recuerda una semana antes, el día anterior y esa misma mañana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää päivämäärä. MenoMap näyttää, kuinka valmiit muistiinpanosi ovat, ja muistuttaa viikkoa ennen, edellisenä päivänä ja samana aamuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez la date. MenoMap indique où en sont vos notes et vous le rappelle une semaine avant, la veille et le matin même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפי את התאריך. MenoMap מראה עד כמה הסיכום שלך מוכן ומזכיר לך שבוע לפני, יום לפני ובבוקר של אותו יום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तारीख़ जोड़ें। MenoMap दिखाता है कि आपके नोट्स कितने तैयार हैं, और एक हफ़्ता पहले, एक दिन पहले और उसी सुबह याद दिलाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj datum. MenoMap pokazuje koliko su tvoje bilješke spremne i podsjeća te tjedan dana prije, dan prije i tog jutra."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg a dátumot. A MenoMap megmutatja, mennyire állnak készen a jegyzeteid, és emlékeztet egy héttel előtte, előző nap és aznap reggel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tanggalnya. MenoMap menunjukkan seberapa siap catatanmu dan mengingatkanmu seminggu sebelumnya, sehari sebelumnya, dan pada pagi harinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la data. MenoMap ti mostra quanto sono pronte le tue note e te lo ricorda una settimana prima, il giorno prima e la mattina stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付を追加してください。MenoMapがメモの準備状況を表示し、1週間前、前日、当日の朝にお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 추가하세요. MenoMap이 메모 준비 상태를 보여 주고, 일주일 전, 전날, 당일 아침에 알려 드려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tarikhnya. MenoMap menunjukkan tahap kesediaan nota anda dan mengingatkan anda seminggu sebelum, sehari sebelum dan pada pagi itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn datoen. MenoMap viser hvor klare notatene dine er, og minner deg på det en uke før, dagen før og samme morgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de datum in. MenoMap laat zien hoe compleet je notities zijn en herinnert je een week ervoor, de dag ervoor en die ochtend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj datę. MenoMap pokaże, na ile gotowe są twoje notatki, i przypomni o wizycie tydzień wcześniej, dzień wcześniej i tego samego ranka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a data. O MenoMap mostra o quanto suas notas estão prontas e lembra você uma semana antes, na véspera e na manhã do dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona a data. O MenoMap mostra até que ponto as tuas notas estão prontas e lembra-te uma semana antes, na véspera e nessa manhã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă data. MenoMap îți arată cât de pregătite sunt notițele și îți amintește cu o săptămână înainte, cu o zi înainte și în dimineața respectivă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridaj dátum. MenoMap ukáže, nakoľko sú tvoje poznámky pripravené, a pripomenie ti ich týždeň vopred, deň vopred a v to ráno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till datumet. MenoMap visar hur klara dina anteckningar är och påminner dig en vecka före, dagen före och samma morgon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มวันนัด MenoMap จะแสดงว่าสรุปของคุณพร้อมแค่ไหน และเตือนคุณล่วงหน้าหนึ่งสัปดาห์ หนึ่งวันก่อน และเช้าวันนัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarihi ekle. MenoMap notlarının ne kadar hazır olduğunu gösterir ve sana bir hafta önce, bir gün önce ve o sabah hatırlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай дату. MenoMap показує, наскільки готові твої нотатки, і нагадає за тиждень, за день і того ж ранку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ngày hẹn. MenoMap cho biết ghi chú của bạn đã sẵn sàng đến đâu và nhắc bạn trước một tuần, trước một ngày và vào sáng hôm đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加日期。MenoMap 会显示笔记准备得怎么样，并在一周前、前一天和当天早上提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
