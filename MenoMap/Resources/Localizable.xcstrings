          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenis hanya membantu menyusun senarai dan nota anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typene hjelper bare med å organisere listen og notatene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Types helpen alleen om je lijst en notities te ordenen."
          }
        },
        "pl" : {
          "stringUnit" : {
