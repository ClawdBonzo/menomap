        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לעיתים קרובות הם מגיעים לשיא ונרגעים תוך דקה או שתיים. זה אינו טיפול רפואי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये अक्सर कुछ मिनटों में चरम पर पहुँचकर कम हो जाती हैं। यह कोई चिकित्सा उपचार नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovakvi valovi često dosegnu vrhunac i popuste u nekoliko minuta. Ovo nije medicinsko liječenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek gyakran néhány percen belül tetőznek, majd enyhülnek. Ez nem orvosi kezelés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini sering memuncak lalu mereda dalam beberapa menit. Ini bukan pengobatan medis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso raggiungono il picco e si attenuano nel giro di un paio di minuti. Questo non è un trattamento medico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
