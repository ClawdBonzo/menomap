        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz: sayılarının filigranlı 7 günlük önizlemesi. Pro ya da tek seferlik Randevu Raporu tam notların kilidini açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безкоштовно: 7-денний попередній перегляд твоїх показників із водяним знаком. Pro або одноразовий «Звіт для візиту» відкриває повні нотатки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí: bản xem trước 7 ngày về số lần, có hình mờ. Pro hoặc một Báo cáo buổi khám mua một lần sẽ mở khóa ghi chú đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费：带水印的 7 天次数预览。Pro 或一次性购买的就诊报告可解锁完整笔记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費版：附浮水印的 7 天次數預覽。Pro 或單次就診報告可解鎖完整筆記。"
          }
        }
      }
    },
