        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาการเหล่านี้มักขึ้นถึงจุดสูงสุดแล้วทุเลาลงภายในสองสามนาที นี่ไม่ใช่การรักษาทางการแพทย์"
