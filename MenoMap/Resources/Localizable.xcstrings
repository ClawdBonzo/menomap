            "state" : "translated",
            "value" : "Guardado. %@ de clima, en el registro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu. %@ omaa säätä, kirjattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré. %@ de météo intérieure, c’est noté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשמר. %@ של מזג אוויר, מתועד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव हो गया। %@ का मौसम दर्ज।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno. %@ osobnog nevremena, zabilježeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentve. %@ időjárás a naplóban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersimpan. %@ cuaca panas, sudah dicatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata. %@ di meteo personale, agli atti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しました。%@ぶんの「お天気」を記録しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장했어요. %@ 동안의 날씨, 기록 완료."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan. %@ cuaca panas, sudah dicatat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret. %@ med eget vær er registrert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaard. %@ aan eigen weer vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano. %@ pogody w dzienniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo: %@ de verão particular no registro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado. Boletim meteorológico: %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvat. %@ de caniculă, la dosar."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené. %@ počasia, zaznamenané."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparat. %@ väder, loggat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกแล้ว สภาพอากาศในตัว %@ จดไว้เรียบร้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedildi. Hava raporu: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено. %@ погоди — у журналі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu. Đã ghi lại %@ thời tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存。%@ 的“天气”，已记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存。%@ 的天氣，記錄完畢。"
          }
        }
      }
    },
    "Say \"Log a hot flash in MenoMap\" or \"Start a night sweat in MenoMap\"." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قولي «سجّل هبّة ساخنة في MenoMap» أو «سجّل تعرّقًا ليليًا في MenoMap»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni „Zaznamenej nával horka v aplikaci MenoMap“ nebo „Zaznamenej noční pocení v aplikaci MenoMap“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig »Registrer en hedetur i MenoMap« eller »Registrer nattesved i MenoMap«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „Hitzewallung in MenoMap eintragen“ oder „Nachtschweiß in MenoMap eintragen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες «Κατάγραψε μια έξαψη στο MenoMap» ή «Κατάγραψε μια νυχτερινή εφίδρωση στο MenoMap»."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say \"Log a hot flush in MenoMap\" or \"Start a night sweat in MenoMap\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di «Registra un sofoco en MenoMap» o «Registra un sudor nocturno en MenoMap»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “Registra un bochorno en MenoMap” o “Registra un sudor nocturno en MenoMap”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano ”Kirjaa kuuma aalto MenoMap-appiin” tai ”Kirjaa yöhikoilu MenoMap-appiin”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Noter une bouffée de chaleur dans MenoMap » ou « Noter des sueurs nocturnes dans MenoMap »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמרי ״לרשום גל חום ב-MenoMap״ או ״לרשום הזעת לילה ב-MenoMap״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“MenoMap में हॉट फ़्लैश दर्ज करो” या “MenoMap में रात का पसीना दर्ज करो” बोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reci „Zabilježi valung u aplikaciji MenoMap“ ili „Zabilježi noćno znojenje u aplikaciji MenoMap“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd: „Rögzíts egy hőhullámot a MenoMap appban” vagy „Rögzíts egy éjszakai izzadást a MenoMap appban”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan “Catat rasa panas mendadak di MenoMap” atau “Catat keringat malam di MenoMap”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' «Registra una vampata con MenoMap» o «Registra una sudorazione notturna con MenoMap»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「MenoMapでホットフラッシュを記録して」または「MenoMapで寝汗を記録して」と話しかけてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"MenoMap에 안면홍조 기록해 줘\" 또는 \"MenoMap에 야간 발한 기록해 줘\"라고 말하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebut “Catat panas badan mendadak dalam MenoMap” atau “Catat peluh malam dalam MenoMap”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «Registrer en hetetokt i MenoMap» eller «Registrer nattesvette i MenoMap»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg \"Noteer een opvlieger in MenoMap\" of \"Noteer nachtelijk zweten in MenoMap\"."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „Zapisz uderzenie gorąca w MenoMap” lub „Zapisz nocne poty w MenoMap”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Registrar um fogacho no MenoMap” ou “Registrar um suor noturno no MenoMap”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz “Registar um afrontamento no MenoMap” ou “Registar suores noturnos no MenoMap”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune „Înregistrează un bufeu în MenoMap” sau „Înregistrează o transpirație nocturnă în MenoMap”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povedz „Zaznamenaj nával tepla v apke MenoMap“ alebo „Zaznamenaj nočné potenie v apke MenoMap“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg ”Logga en värmevallning i MenoMap” eller ”Logga en nattsvettning i MenoMap”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดว่า “บันทึกอาการร้อนวูบวาบใน MenoMap” หรือ “บันทึกเหงื่อออกตอนกลางคืนใน MenoMap”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri'ye “MenoMap ile sıcak basması kaydet” ya da “MenoMap ile gece terlemesi kaydet” de."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи «Запиши приплив у MenoMap» або «Запиши нічну пітливість у MenoMap»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nói “Ghi cơn bốc hỏa trong MenoMap” hoặc “Ghi cơn đổ mồ hôi đêm trong MenoMap”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“用 MenoMap 记录潮热”或“用 MenoMap 记录夜间盗汗”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出「在 MenoMap 記錄熱潮紅」或「在 MenoMap 記錄夜間盜汗」。"
          }
        }
      }
    },
