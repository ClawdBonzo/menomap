    "Types only help organize your list and notes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأنواع تساعد فقط في تنظيم قائمتكِ وملاحظاتكِ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typy slouží jen k uspořádání seznamu a poznámek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typer hjælper kun med at organisere din liste og dine noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typen helfen nur, deine Liste und Notizen zu ordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τύποι απλώς βοηθούν στην οργάνωση της λίστας και των σημειώσεών σου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Types only help organise your list and notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tipos solo sirven para organizar tu lista y tus notas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tipos solo ayudan a organizar tu lista y tus notas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyypit auttavat vain järjestämään listaasi ja muistiinpanojasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les types servent seulement à organiser votre liste et vos notes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסוגים רק עוזרים לארגן את הרשימה ואת הסיכום שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रकार सिर्फ़ आपकी सूची और नोट्स को व्यवस्थित करने में मदद करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrste služe samo za organiziranje popisa i bilješki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A típusok csak a lista és a jegyzetek rendezését segítik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenis hanya membantu merapikan daftar dan catatanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tipi servono solo a organizzare l'elenco e le note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "種類は、リストとメモを整理するためだけに使われます。"
