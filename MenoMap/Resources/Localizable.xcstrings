          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestea ating adesea un vârf și se domolesc în câteva minute. Acesta nu este un tratament medical."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
