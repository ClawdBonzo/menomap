            "state" : "translated",
            "value" : "Додай дату, і MenoMap вчасно підготує твої нотатки. Необовʼязково."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ngày hẹn, MenoMap sẽ chuẩn bị ghi chú kịp lúc. Không bắt buộc."
          }
        },
        "zh-Hans" : {
