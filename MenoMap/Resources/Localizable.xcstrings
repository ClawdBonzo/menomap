    "Log a surge in one tap. Spot patterns. Walk into your appointment with notes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّلي الموجة بنقرة واحدة. اكتشفي الأنماط. واذهبي إلى موعدكِ ومعكِ ملاحظات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenej vlnu jedním klepnutím. Odhal vzorce. Přijď k lékaři s poznámkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer en bølge med ét tryk. Find mønstre. Mød op til din lægeaftale med noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Welle mit einem Tippen erfassen. Muster erkennen. Mit Notizen in den Termin gehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάγραψε ένα κύμα με ένα πάτημα. Εντόπισε μοτίβα. Πήγαινε στο ραντεβού σου με σημειώσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log a surge in one tap. Spot patterns. Walk into your appointment with notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una oleada con un toque. Detecta patrones. Llega a tu cita con notas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una oleada con un toque. Descubre patrones. Llega a tu cita con notas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa aalto yhdellä napautuksella. Huomaa kuviot. Mene vastaanotolle muistiinpanojen kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez une vague d’un seul toucher. Repérez les tendances. Arrivez à votre rendez-vous avec des notes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רושמים גל בהקשה אחת. מזהים דפוסים. מגיעים לתור עם סיכום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक टैप में लहर दर्ज करें। पैटर्न पहचानें। नोट्स के साथ अपॉइंटमेंट पर जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabilježi val jednim dodirom. Uoči obrasce. Dođi na termin s bilješkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíts egy hullámot egyetlen koppintással. Vedd észre a mintázatokat. Menj jegyzetekkel az időpontodra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat gelombang dengan sekali ketuk. Temukan pola. Datang ke janji temu dengan membawa catatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un'ondata con un tocco. Scopri le ricorrenze. Arriva all'appuntamento con le tue note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンタップでほてりを記録。傾向に気づく。メモを持って受診へ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 탭으로 열감을 기록하세요. 패턴을 발견하세요. 메모를 들고 진료에 가세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat gelombang dengan satu ketikan. Kenal pasti corak. Pergi ke temu janji dengan nota."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer en bølge med ett trykk. Se mønstre. Gå til legetimen med notater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer een golf met één tik. Ontdek patronen. Ga met notities naar je afspraak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
