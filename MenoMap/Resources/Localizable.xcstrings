        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur votre iPhone. Rien n’est envoyé en ligne. Vous pouvez tout exporter ou tout supprimer depuis Vous → Confidentialité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המידע נשאר ב-iPhone שלך. שום דבר לא מועלה. אפשר לייצא או למחוק הכול דרך אני ← פרטיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके iPhone पर ही रहता है। कुछ भी अपलोड नहीं होता। आप प्रोफ़ाइल → गोपनीयता से सब कुछ एक्सपोर्ट कर सकती हैं या मिटा सकती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostaje na tvom iPhoneu. Ništa se ne prenosi. Sve možeš izvesti ili izbrisati u Profil → Privatnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone-odon marad. Semmi sem kerül feltöltésre. Mindent exportálhatsz vagy törölhetsz itt: Profil → Adatvédelem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
