    "Fully automatic: in the Shortcuts app, tap Automation → + → Sleep (or Focus → Sleep) → When turning on → Arm Night Watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقائي بالكامل: في تطبيق الاختصارات، اضغطي على الأتمتة ← + ← النوم (أو التركيز ← النوم) ← عند التشغيل ← تفعيل حراسة الليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plně automaticky: v aplikaci Zkratky klepni na Automatizace → + → Spánek (nebo Soustředění → Spánek) → Při zapnutí → Zapnout Noční hlídku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt automatisk: I appen Genveje skal du trykke på Automatisering → + → Søvn (eller Fokus → Søvn) → Når den slås til → Slå Nattevagt til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz automatisch: Tippe in der App „Kurzbefehle“ auf „Automation“ → + → „Schlafen“ (oder „Fokus“ → „Schlafen“) → „Beim Aktivieren“ → „Nachtwache aktivieren“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρως αυτόματα: στην εφαρμογή Συντομεύσεις, άγγιξε Αυτοματισμός → + → Ύπνος (ή Συγκέντρωση → Ύπνος) → Κατά την ενεργοποίηση → Ενεργοποίηση Νυχτερινής Βάρδιας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fully automatic: in the Shortcuts app, tap Automation → + → Sleep (or Focus → Sleep) → When turning on → Arm Night Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente automático: en la app Atajos, toca Automatización → + → Dormir (o Concentración → Dormir) → Al activarse → Activar Guardia nocturna."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente automático: en la app Atajos, toca Automatización → + → Dormir (o Enfoque → Dormir) → Al activarse → Activar Guardia Nocturna."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin automaattinen: napauta Pikakomennot-apissa Automaatio → + → Nukkuminen (tai Keskity-tila → Nukkuminen) → Kun se laitetaan päälle → Kytke Yövahti päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement automatique : dans l’app Raccourcis, touchez Automatisation → + → Sommeil (ou Concentration → Sommeil) → Lors de l’activation → Activer la Veille de nuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אוטומטי לגמרי: ביישום ״קיצורים״, הקישי על ״אוטומציה״ ← + ← ״שינה״ (או ״ריכוז״ ← ״שינה״) ← ״בעת ההפעלה״ ← ״הפעלת משמר לילה״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी तरह अपने-आप: शॉर्टकट ऐप में ऑटोमेशन → + → नींद (या फ़ोकस → नींद) → चालू होने पर → रात का पहरा चालू करें पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuno automatski: u aplikaciji Prečaci dodirni Automatizacija → + → Spavanje (ili Fokus → Spavanje) → Prilikom uključivanja → Uključi Noćnu stražu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljesen automatikusan: a Parancsok appban koppints ezekre: Automatizálás → + → Alvás (vagy Fókusz → Alvás) → Bekapcsoláskor → Éjjeliőr bekapcsolása."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepenuhnya otomatis: di app Pintasan, ketuk Otomatisasi → + → Tidur (atau Fokus → Tidur) → Saat Dinyalakan → Aktifkan Jaga Malam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente automatico: nell'app Comandi rapidi, tocca Automazione → + → Riposo (o Full immersion → Riposo) → Quando si attiva → Attiva Veglia notturna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全に自動にするには：ショートカット Appで「オートメーション」→「＋」→「睡眠」（または「集中モード」→「睡眠」）→「オンになったとき」→「夜の見守りをオンにする」の順にタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전 자동: 단축어 앱에서 자동화 → + → 수면(또는 집중 모드 → 수면) → 켜질 때 → 밤 지킴이 켜기를 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatik sepenuhnya: dalam app Pintasan, ketik Automasi → + → Tidur (atau Fokus → Tidur) → Apabila Dihidupkan → Aktifkan Jaga Malam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt automatisk: I Snarveier-appen trykker du på Automatisering → + → Søvn (eller Fokus → Søvn) → Når den slås på → Slå på Nattevakt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig automatisch: tik in de Opdrachten-app op Automatisering → + → Slaap (of Focus → Slaap) → Bij inschakelen → Zet Nachtwacht aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pełni automatycznie: w aplikacji Skróty stuknij Automatyzacja → + → Sen (lub Tryb skupienia → Sen) → Po włączeniu → Włącz Nocną wartę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente automático: no app Atalhos, toque em Automação → + → Sono (ou Foco → Sono) → Ao ativar → Ativar Plantão Noturno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente automático: na aplicação Atalhos, toca em Automatização → + → Dormir (ou Modo de concentração → Dormir) → Ao ativar → Ativar a Guarda Noturna."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complet automat: în aplicația Scurtături, apasă Automatizare → + → Somn (sau Concentrare → Somn) → Când este activat → Activează Veghea de noapte."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úplne automaticky: v apke Skratky ťukni na Automatizácia → + → Spánok (alebo Môj čas → Spánok) → Pri zapnutí → Zapnúť Nočnú stráž."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt automatiskt: i appen Genvägar trycker du på Automatisering → + → Sömn (eller Fokus → Sömn) → När det aktiveras → Slå på Nattvakt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัตโนมัติทั้งหมด: ในแอปคำสั่งลัด แตะ ระบบอัตโนมัติ → + → การนอนหลับ (หรือ โฟกัส → การนอนหลับ) → เมื่อเปิด → เปิดยามราตรี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam otomatik: Kestirmeler uygulamasında Otomasyon → + → Uyku (ya da Odak → Uyku) → Açıldığında → Gece Nöbetini aç yolunu izle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повністю автоматично: у програмі «Швидкі команди» торкнися Автоматизація → + → Сон (або Зосередження → Сон) → Під час увімкнення → Увімкнути Нічну варту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn toàn tự động: trong ứng dụng Phím tắt, chạm vào Tự động hóa → + → Ngủ (hoặc Tập trung → Ngủ) → Khi bật → Bật Canh đêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全自动：在“快捷指令” App 中，轻点“自动化”→“+”→“睡眠”（或“专注模式”→“睡眠”）→“打开时”→“开启夜间守护”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
