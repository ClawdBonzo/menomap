    "Glad it helped. Keep logging and your next notes will be even sharper." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسعدنا أنه ساعد. تابعي التسجيل وستكون ملاحظاتكِ القادمة أدق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsme rádi, že to pomohlo. Zaznamenávej dál a tvoje příští poznámky budou ještě přesnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt, at det hjalp. Bliv ved med at registrere, så bliver dine næste noter endnu skarpere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schön, dass es geholfen hat. Trag weiter ein, dann werden deine nächsten Notizen noch genauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαιρόμαστε που βοήθησε. Συνέχισε την καταγραφή και οι επόμενες σημειώσεις σου θα είναι ακόμη πιο εύστοχες."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glad it helped. Keep logging and your next notes will be even sharper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos alegra que te haya servido. Sigue registrando y tus próximas notas serán aún más precisas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué bueno que te sirvió. Sigue registrando y tus próximas notas serán aún más precisas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hienoa, että siitä oli apua. Jatka kirjaamista, niin seuraavat muistiinpanosi ovat vielä tarkemmat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant mieux si cela vous a été utile. Continuez à noter, et vos prochaines notes seront encore plus précises."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמחים שזה עזר. המשיכי לתעד, והסיכום הבא שלך יהיה חד עוד יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ुशी है कि मदद मिली। दर्ज करती रहें, आपके अगले नोट्स और भी सटीक होंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drago nam je da je pomoglo. Nastavi bilježiti i tvoje će sljedeće bilješke biti još preciznije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jó, hogy segített. Naplózz tovább, és a következő jegyzeteid még pontosabbak lesznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senang bisa membantu. Terus mencatat, dan catatanmu berikutnya akan makin tajam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felice che ti sia stato utile. Continua a registrare e le tue prossime note saranno ancora più precise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お役に立ててよかったです。記録を続けると、次のメモがさらに充実します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도움이 됐다니 다행이에요. 계속 기록하면 다음 메모가 더 선명해져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baguslah ia membantu. Teruskan mencatat dan nota anda yang seterusnya akan lebih tepat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fint at det hjalp. Fortsett å registrere, så blir de neste notatene dine enda skarpere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijn dat het hielp. Blijf bijhouden, dan worden je volgende notities nog scherper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieszymy się, że pomogło. Zapisuj dalej, a kolejne notatki będą jeszcze trafniejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bom que ajudou. Continue registrando e suas próximas notas vão ficar ainda mais precisas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda bem que ajudou. Continua a registar e as tuas próximas notas vão ficar ainda mais precisas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bucurăm că te-a ajutat. Continuă să înregistrezi și următoarele notițe vor fi și mai precise."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sme radi, že to pomohlo. Zaznamenávaj ďalej a tvoje ďalšie poznámky budú ešte presnejšie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skönt att det hjälpte. Fortsätt logga så blir nästa anteckningar ännu vassare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดีใจที่ช่วยได้ บันทึกต่อไป แล้วสรุปครั้งหน้าจะชัดเจนยิ่งขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşine yaradığına sevindik. Kaydetmeye devam et, sonraki notların daha da net olsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раді, що це допомогло. Записуй далі, і наступні нотатки будуть ще точнішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thật vui vì điều đó hữu ích. Hãy tiếp tục ghi lại, ghi chú lần sau sẽ còn rõ ràng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高兴对你有帮助。继续记录，你下一次的笔记会更清楚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高興有幫助。持續記錄，你下一次的筆記會更清楚。"
          }
        }
      }
    },
