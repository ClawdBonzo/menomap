        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji unosi: valovi u zabilježenim danima prije (%2$lld): %1$lld; u zabilježenim danima tijekom (%4$lld): %3$lld. To je ono što si zabilježila, a ne dokaz uzroka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejegyzéseid: az előtte rögzített %2$lld napban %1$lld hullám, a közben rögzített %4$lld napban %3$lld. Ezt rögzítetted, ez nem bizonyíték az okra."
