    "By continuing you agree that MenoMap processes the health information you enter on this device to show your logs, patterns and notes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالمتابعة، توافقين على أن يعالج MenoMap المعلومات الصحية التي تُدخلينها على هذا الجهاز لعرض سجلاتكِ وأنماطكِ وملاحظاتكِ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračováním souhlasíš s tím, že MenoMap zpracovává zdravotní údaje, které na tomto zařízení zadáš, aby ti mohl zobrazit záznamy, vzorce a poznámky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at fortsætte accepterer du, at MenoMap behandler de helbredsoplysninger, du indtaster på denne enhed, for at vise dine registreringer, mønstre og noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, stimmst du zu, dass MenoMap die Gesundheitsdaten, die du auf diesem Gerät eingibst, verarbeitet, um deine Einträge, Muster und Notizen anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζοντας, συμφωνείς ότι το MenoMap επεξεργάζεται τις πληροφορίες υγείας που καταχωρίζεις σε αυτή τη συσκευή, για να εμφανίζει τις καταγραφές, τα μοτίβα και τις σημειώσεις σου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing you agree that MenoMap processes the health information you enter on this device to show your logs, patterns and notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas que MenoMap trate en este dispositivo la información de salud que introduces para mostrarte tus registros, patrones y notas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas que MenoMap procese en este dispositivo la información de salud que ingresas para mostrarte tus registros, patrones y notas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkamalla hyväksyt, että MenoMap käsittelee tällä laitteella antamiasi terveystietoja näyttääkseen kirjauksesi, kuviot ja muistiinpanot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous acceptez que MenoMap traite les données de santé que vous saisissez sur cet appareil pour afficher votre journal, vos tendances et vos notes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהמשך השימוש את מסכימה ש-MenoMap יעבד את המידע הבריאותי שאת מזינה במכשיר הזה, כדי להציג את התיעוד, הדפוסים והסיכום שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे बढ़कर आप सहमति देती हैं कि MenoMap इस डिवाइस पर आपके द्वारा दर्ज सेहत जानकारी को प्रोसेस करेगा, ताकि आपके लॉग, पैटर्न और नोट्स दिखा सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavkom pristaješ da MenoMap na ovom uređaju obrađuje zdravstvene podatke koje uneseš kako bi prikazao tvoje zapise, obrasce i bilješke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folytatással elfogadod, hogy a MenoMap ezen az eszközön feldolgozza az általad megadott egészségügyi adatokat, hogy megjelenítse a naplóidat, mintázataidat és jegyzeteidet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan melanjutkan, kamu setuju bahwa MenoMap memproses informasi kesehatan yang kamu masukkan di perangkat ini untuk menampilkan riwayat, pola, dan catatanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuando accetti che MenoMap elabori su questo dispositivo le informazioni sanitarie che inserisci, per mostrarti registri, ricorrenze e note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行すると、あなたがこのデバイスで入力した健康情報を、記録・傾向・メモの表示のためにMenoMapが処理することに同意したことになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하면 MenoMap이 기록, 패턴, 진료 메모를 보여 주기 위해 이 기기에서 입력한 건강 정보를 처리하는 데 동의하게 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan meneruskan, anda bersetuju bahawa MenoMap memproses maklumat kesihatan yang anda masukkan pada peranti ini untuk menunjukkan log, corak dan nota anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å fortsette godtar du at MenoMap behandler helseopplysningene du legger inn på denne enheten, for å vise loggene, mønstrene og notatene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door verder te gaan ga je ermee akkoord dat MenoMap de gezondheidsgegevens die je op dit apparaat invoert verwerkt om je logboek, patronen en notities te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuując, zgadzasz się, aby MenoMap przetwarzała informacje o zdrowiu, które wprowadzasz na tym urządzeniu, w celu pokazywania twoich wpisów, wzorców i notatek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, você concorda que o MenoMap processe as informações de saúde que você insere neste dispositivo para mostrar seus registros, padrões e notas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, aceitas que o MenoMap trate as informações de saúde que introduzes neste dispositivo para mostrar os teus registos, padrões e notas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuând, ești de acord ca MenoMap să prelucreze pe acest dispozitiv informațiile despre sănătate pe care le introduci, pentru a-ți afișa înregistrările, tiparele și notițele."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračovaním súhlasíš s tým, že MenoMap spracúva zdravotné údaje, ktoré zadáš v tomto zariadení, aby ti zobrazil tvoje záznamy, vzorce a poznámky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att fortsätta godkänner du att MenoMap behandlar de hälsouppgifter du anger på den här enheten för att visa dina loggar, mönster och anteckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อดำเนินการต่อ คุณยินยอมให้ MenoMap ประมวลผลข้อมูลสุขภาพที่คุณป้อนบนอุปกรณ์นี้ เพื่อแสดงบันทึก รูปแบบ และสรุปของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederek, MenoMap'ın bu aygıta girdiğin sağlık bilgilerini kayıtlarını, örüntülerini ve notlarını göstermek için işlemesini kabul etmiş olursun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продовжуючи, ти погоджуєшся, що MenoMap обробляє інформацію про здоровʼя, яку ти вводиш на цьому пристрої, щоб показувати твої записи, закономірності й нотатки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tiếp tục, bạn đồng ý để MenoMap xử lý thông tin sức khỏe bạn nhập trên thiết bị này nhằm hiển thị nhật ký, mẫu hình và ghi chú của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续即表示你同意 MenoMap 在本设备上处理你输入的健康信息，用于显示你的记录、规律和笔记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續即表示你同意 MenoMap 在這部裝置上處理你輸入的健康資訊，以顯示你的紀錄、規律和筆記。"
          }
        }
      }
    },
