    "Skip alcohol after 7pm for two weeks. Keep logging surges as usual." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امتنعي عن الكحول بعد 7 مساءً لمدة أسبوعين. وتابعي تسجيل الموجات كالمعتاد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva týdny žádný alkohol po 19:00. Vlny zaznamenávej jako obvykle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop alkohol efter kl. 19 i to uger. Bliv ved med at registrere bølger som normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Wochen lang kein Alkohol nach 19 Uhr. Trag Wellen weiter wie gewohnt ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς αλκοόλ μετά τις 19:00 για δύο εβδομάδες. Συνέχισε να καταγράφεις τα κύματα όπως συνήθως."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip alcohol after 7pm for two weeks. Keep logging surges as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de alcohol después de las 19:00 durante dos semanas. Sigue registrando las oleadas como siempre."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita el alcohol después de las 19:00 durante dos semanas. Sigue registrando tus oleadas como siempre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä alkoholi pois klo 19 jälkeen kahden viikon ajan. Jatka aaltojen kirjaamista tavalliseen tapaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’alcool après 19 h pendant deux semaines. Continuez à noter vos vagues comme d’habitude."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי אלכוהול אחרי 19:00 במשך שבועיים. המשיכי לתעד גלים כרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो हफ़्ते तक शाम 7 बजे के बाद शराब न लें। लहरें हमेशा की तरह दर्ज करती रहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preskoči alkohol nakon 19 h dva tjedna. Nastavi bilježiti valove kao i obično."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két hétig ne igyál alkoholt este 7 után. A hullámokat rögzítsd tovább a szokásos módon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari alkohol setelah pukul 19.00 selama dua minggu. Tetap catat gelombang seperti biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente alcol dopo le 19 per due settimane. Continua a registrare le ondate come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2週間、19時以降のお酒を控えます。ほてりはいつもどおり記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2주 동안 오후 7시 이후에는 술을 마시지 마세요. 열감은 평소처럼 계속 기록하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elakkan alkohol selepas 7 malam selama dua minggu. Teruskan mencatat gelombang seperti biasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropp alkohol etter kl. 19 i to uker. Fortsett å registrere bølger som vanlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee weken geen alcohol na 19 uur. Blijf golven gewoon noteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pij alkoholu po 19:00 przez dwa tygodnie. Zapisuj fale jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem álcool depois das 19h por duas semanas. Continue registrando as ondas como sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de álcool depois das 19h durante duas semanas. Continua a registar as ondas como habitualmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renunță la alcool după ora 19, timp de două săptămâni. Continuă să înregistrezi valurile ca de obicei."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva týždne vynechaj alkohol po 19:00. Vlny zaznamenávaj ako zvyčajne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen alkohol efter kl. 19 i två veckor. Fortsätt logga vågor som vanligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งดแอลกอฮอล์หลัง 19:00 เป็นเวลาสองสัปดาห์ บันทึกระลอกร้อนตามปกติต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki hafta boyunca 19:00'dan sonra alkol alma. Dalgaları her zamanki gibi kaydetmeye devam et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не пий алкоголь після 19:00 протягом двох тижнів. Записуй хвилі як зазвичай."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không uống rượu bia sau 7 giờ tối trong hai tuần. Vẫn ghi cơn nóng như bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两周内晚上 7 点后不喝酒。照常记录热浪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續兩週，晚上 7 點後不喝酒。照常記錄熱浪。"
          }
        }
      }
    },
