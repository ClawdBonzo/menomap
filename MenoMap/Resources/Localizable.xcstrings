        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttäjän itse kirjaamat tiedot. Ei diagnoosi. Ei täydellinen potilaskertomus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données saisies par la personne qui utilise l’app. Pas un diagnostic. Pas un dossier médical complet."
