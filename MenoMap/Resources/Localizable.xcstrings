          "stringUnit" : {
            "state" : "translated",
            "value" : "寝汗以外に、睡眠に影響しているものはありますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야간 발한 말고 다른 무언가가 제 수면에 영향을 줄 수 있나요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah perkara lain selain berpeluh pada waktu malam mungkin menjejaskan tidur saya?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan noe annet enn nattesvette påvirke søvnen min?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan iets anders dan nachtelijk zweten mijn slaap verstoren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy coś innego niż nocne poty może wpływać na mój sen?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo além dos suores noturnos pode estar afetando meu sono?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode haver outra coisa, além dos suores noturnos, a afetar o meu sono?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar putea altceva decât transpirațiile nocturne să-mi afecteze somnul?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môže môj spánok ovplyvňovať aj niečo iné ako nočné potenie?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan något annat än nattsvettningar påverka min sömn?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีอะไรอื่นนอกจากเหงื่อออกตอนกลางคืนที่อาจส่งผลต่อการนอนของฉันไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykumu gece terlemeleri dışında bir şey etkiliyor olabilir mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи може щось, крім нічної пітливості, впливати на мій сон?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liệu có điều gì khác ngoài đổ mồ hôi ban đêm đang ảnh hưởng đến giấc ngủ của tôi không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
