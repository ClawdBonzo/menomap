    "Days to your next appointment and how ready your notes are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام المتبقية حتى موعدكِ القادم ومدى جاهزية ملاحظاتكِ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dny do další návštěvy a jak připravené jsou tvoje poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dage til din næste aftale, og hvor klar dine noter er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage bis zu deinem nächsten Termin und wie weit deine Notizen sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ημέρες ως το επόμενο ραντεβού σου και πόσο έτοιμες είναι οι σημειώσεις σου."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Days to your next appointment and how ready your notes are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días hasta tu próxima cita y lo preparadas que están tus notas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Días para tu próxima cita y qué tan listas están tus notas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivät seuraavaan käyntiin ja muistiinpanojesi valmius."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours avant votre prochain rendez-vous et état de préparation de vos notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימים שנותרו עד התור הבא, ועד כמה הסיכום שלך מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अगले अपॉइंटमेंट तक बचे दिन और आपके नोट्स कितने तैयार हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani do sljedećeg termina i koliko su bilješke spremne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány nap van a következő időpontig, és mennyire állnak készen a jegyzeteid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari menuju janji temu berikutnya dan seberapa siap catatanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni al prossimo appuntamento e quanto sono pronte le tue note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の受診までの日数と、メモの準備状況。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 진료까지 남은 날과 메모 준비 상태."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan hari ke temu janji anda yang seterusnya dan tahap kesediaan nota anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dager til neste legetime og hvor klare notatene dine er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen tot je volgende afspraak en hoe compleet je notities zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni do następnej wizyty i stan gotowości twoich notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias até a sua próxima consulta e o quanto suas notas estão prontas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias até à tua próxima consulta e até que ponto as tuas notas estão prontas."
          }
        },
        "ro": {
          "stringUnit": {
